/* Voice ordering on patient-facing front */
let voiceRecognition=null, voiceListening=false;
function voiceOrderCard(context){
  const name=context?.name||'there';
  return `<section class="voice-card" id="voiceOrderCard"><div class="voice-inner"><div class="voice-mic" id="voiceMic">🎙️</div><div class="voice-copy"><span class="ops-kicker"><i class="ops-pulse"></i> Hands-free comfort</span><h3>Order food with your voice</h3><p>Say a meal, individual food, tea, coffee or juice. My Meal Tracker will find the closest menu item and ask for confirmation before placing the request.</p><div class="voice-transcript" id="voiceTranscript">Try: “Order paneer quinoa bowl” or “Order coffee for 3 PM”</div><div class="voice-state" id="voiceState">Voice is ready · ${escapeHtml(name)}</div></div><div class="voice-actions"><button class="voice-primary" onclick="window.startVoiceOrder(false)">🎙️ Start voice order</button><button onclick="openMenuPlanner()">📅 Open menu</button></div></div><div class="voice-hints"><span class="voice-hint">“Order breakfast early”</span><span class="voice-hint">“Order Greek yogurt”</span><span class="voice-hint">“Order tea at 4 PM”</span><span class="voice-hint">“Show menu”</span></div></section>`;
}
function getVoiceCandidates(p){
  const diet=p?.diet||'Diabetic Care'; const out=[];
  (menus[diet]||[]).forEach(m=>(m[2]||[]).forEach(f=>out.push({name:f[0],kind:'Scheduled meal item',time:m[0],prep:String(f[1]).match(/(\d+)/)?.[1]||'',kcal:f[2],protein:f[3],source:'meal'})));
  (individualMenus[diet]||[]).forEach(f=>out.push({...f,source:'individual'}));
  (beverageMenus[diet]||[]).forEach(f=>out.push({...f,source:'beverage'}));
  return out;
}
function startVoiceOrder(){
  const Speech=window.SpeechRecognition||window.webkitSpeechRecognition;
  const state=document.getElementById('voiceState'), card=document.getElementById('voiceOrderCard'), transcript=document.getElementById('voiceTranscript');
  if(!Speech){if(state){state.textContent='Voice input is not available in this browser. Use the menu button or type your request in the AI assistant.';state.className='voice-state warn'}toast('Voice input is unavailable in this browser');return;}
  if(voiceListening && voiceRecognition){voiceRecognition.stop();return;}
  voiceRecognition=new Speech();voiceRecognition.lang='en-IN';voiceRecognition.interimResults=true;voiceRecognition.continuous=false;voiceListening=true;
  if(card)card.classList.add('listening'); if(state){state.textContent='Listening… say the food or drink you want.';state.className='voice-state ok'}
  voiceRecognition.onresult=e=>{let text='';for(const r of e.results){text+=r[0].transcript+' '}text=text.trim();if(transcript)transcript.textContent=`Heard: “${text}”`;if(e.results[e.results.length-1].isFinal){voiceListening=false;if(card)card.classList.remove('listening');processVoiceOrder(text)}};
  voiceRecognition.onerror=e=>{voiceListening=false;if(card)card.classList.remove('listening');if(state){state.textContent=`Voice stopped · ${e.error==='not-allowed'?'microphone permission required':'try again'}`;state.className='voice-state warn'}toast('Voice input stopped — please try again');};
  voiceRecognition.onend=()=>{voiceListening=false;if(card)card.classList.remove('listening');};
  try{voiceRecognition.start()}catch(_){voiceListening=false;if(card)card.classList.remove('listening');toast('Voice input could not start')}
}
function processVoiceOrder(text){
  const p=session.role==='patient'?patients[session.patientKey]:null; if(!p){toast('Voice ordering is available from the patient-facing portal');return}
  const q=String(text||'').toLowerCase();
  if(q.includes('show menu')||q.includes('menu')){openMenuPlanner();return}
  const candidates=getVoiceCandidates(p); let best=null,score=0;
  for(const item of candidates){const tokens=item.name.toLowerCase().split(/[^a-z0-9]+/).filter(x=>x.length>2);const s=tokens.reduce((n,t)=>n+(q.includes(t)?1:0),0);if(s>score){score=s;best=item}}
  if(!best){openModal('Voice order',`I heard “${text}”. I could not confidently match it to ${p.diet}. Open Menu Planning to choose the exact item, or try saying the full food name.`,()=>{closeModal();openMenuPlanner()});return}
  openModal('Confirm voice order',`${p.name}: ${best.name}. Planned time ${best.time||'as requested'} · Prep ${best.prep||'—'} min · ${best.kcal||'—'} kcal · ${best.protein||'—'} g protein. This patient request will follow the dietitian-review checkpoint before F&B.`,()=>placeVoiceOrder(best));
}
function placeVoiceOrder(item){const p=patients[session.patientKey];orders.unshift({id:`ML-${orderSeq++}`,patient:p.name,diet:p.diet,meal:`Voice · ${item.name}`,time:item.time||'Now',staff:p.service,status:'Dietitian Review',kind:item.source||'voice',approval:'Pending dietitian review'});closeModal();toast(`${item.name} sent for dietitian review`);renderMain()}

