  window.v22SetMode=function(mode){session.menuMode=mode;if(document.getElementById('menuBackdrop')?.style.display==='block')renderDrawer();else if(session.role==='patient')setInlineMenuHost(fallbackPatient());else if(session.role==='attender'){typeof renderMain==='function'&&renderMain();} };
  function renderDrawer(){
    const mb=document.getElementById('menuBackdrop'); if(!mb)return;
    if(session.role==='patient'){
