function downloadApp(evt){
  const btn=(evt&&evt.currentTarget)||document.getElementById('downloadAppBtn');
  try{
    if(btn){btn.disabled=true;btn.dataset.label=btn.innerHTML;btn.innerHTML='⏳ Preparing…';}
    const html='<!DOCTYPE html>\n'+document.documentElement.outerHTML;
    const blob=new Blob([html],{type:'text/html'});
    const url=URL.createObjectURL(blob);
    const a=document.createElement('a');
    a.href=url; a.download='My-Meal-Tracker.html';
    document.body.appendChild(a); a.click();
    setTimeout(()=>{URL.revokeObjectURL(url); a.remove(); if(btn){btn.disabled=false; btn.innerHTML=btn.dataset.label;}},500);
    toast('Downloading My-Meal-Tracker.html …');
  }catch(err){toast('Download failed — please try again');if(btn){btn.disabled=false; if(btn.dataset.label)btn.innerHTML=btn.dataset.label;}}
}
