<script id="visual-motion-js">
(function(){
  const root=document.body;
  if(!root) return;
  // Ambient visual layer; no content/layout changes.
  if(!document.querySelector('.ambient-field')){
    const field=document.createElement('div');
    field.className='ambient-field';
    field.innerHTML='<span class="ambient-orb o1"></span><span class="ambient-orb o2"></span><span class="ambient-orb o3"></span>';
    root.prepend(field);
  }
  if(!document.querySelector('.cursor-glow')){
    const glow=document.createElement('div');
    glow.className='cursor-glow';
    root.appendChild(glow);
    let visible=false;
    window.addEventListener('pointermove',e=>{
      glow.style.left=e.clientX+'px';
      glow.style.top=e.clientY+'px';
      if(!visible){glow.style.opacity='1';visible=true;}
    },{passive:true});
    window.addEventListener('pointerleave',()=>{glow.style.opacity='0';});
  }
  if(!document.querySelector('.sparkle-layer')){
    const layer=document.createElement('div'); layer.className='sparkle-layer'; root.appendChild(layer);
    const createSpark=()=>{
      if(document.hidden) return;
      const s=document.createElement('span'); s.className='spark';
      s.style.left=(4+Math.random()*92)+'%';
      s.style.top=(18+Math.random()*72)+'%';
      s.style.animationDuration=(3.5+Math.random()*3.5)+'s';
      s.style.animationDelay=(Math.random()*.6)+'s';
      layer.appendChild(s);
      setTimeout(()=>s.remove(),7500);
    };
    for(let i=0;i<8;i++) setTimeout(createSpark,i*260);
    setInterval(createSpark,900);
  }
  // Stagger existing content for a richer demo entrance.
  const staggerSelectors=['.wrap > *','.card','.stat','.lift','.service-banner'];
  let delay=0;
  document.querySelectorAll(staggerSelectors.join(',')).forEach((el)=>{
    if(el.dataset.motionInit) return;
    el.dataset.motionInit='1';
    el.style.animationDelay=Math.min(delay,900)+'ms';
    delay+=45;
  });
  // Button click ripple, purely visual.
  document.addEventListener('click',e=>{
    const btn=e.target.closest('button');
    if(!btn || btn.disabled) return;
    const r=document.createElement('span'); r.className='ripple';
    const rect=btn.getBoundingClientRect();
    const size=Math.max(rect.width,rect.height);
    r.style.width=size+'px'; r.style.height=size+'px';
    r.style.left=(e.clientX-rect.left-size/2)+'px'; r.style.top=(e.clientY-rect.top-size/2)+'px';
    btn.appendChild(r); setTimeout(()=>r.remove(),700);
  });
  // Subtle tilt only on larger desktop cards, while preserving their click targets.
  const canTilt=window.matchMedia && window.matchMedia('(pointer:fine)').matches;
  if(canTilt){
    const tiltTargets=()=>document.querySelectorAll('.app .journey-premium,.app .service-banner,.app .lift,.app .card');
    const attach=()=>tiltTargets().forEach(el=>{
      if(el.dataset.tiltBound) return;
      el.dataset.tiltBound='1';
      el.addEventListener('pointermove',ev=>{
        if(window.innerWidth<920) return;
        const r=el.getBoundingClientRect();
        const x=(ev.clientX-r.left)/r.width-.5, y=(ev.clientY-r.top)/r.height-.5;
        const rx=Math.max(-2.2,Math.min(2.2,-y*3.2)), ry=Math.max(-2.2,Math.min(2.2,x*3.2));
        el.style.transform='perspective(900px) rotateX('+rx+'deg) rotateY('+ry+'deg) translateY(-2px)';
      });
      el.addEventListener('pointerleave',()=>{el.style.transform='';});
    });
    attach();
    const mo=new MutationObserver(attach); mo.observe(root,{childList:true,subtree:true});
  }
  // Scroll reveal for dynamically-rendered app sections.
  if('IntersectionObserver' in window){
    const io=new IntersectionObserver(entries=>entries.forEach(entry=>{if(entry.isIntersecting){entry.target.classList.add('fade-in-soft');}}),{threshold:.08});
    const observe=()=>document.querySelectorAll('.app .section,.app .section-reveal,.app .care-grid > *, .app .priority-grid > *').forEach(el=>io.observe(el));
    observe();
    new MutationObserver(observe).observe(root,{childList:true,subtree:true});
  }
})();
