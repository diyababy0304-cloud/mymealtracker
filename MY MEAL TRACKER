<!DOCTYPE html>
<html lang="en"><head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MY MEAL TRACKER</title>
<style>
:root{
  --navy:#082b5f;--blue:#126bc5;--blue2:#0a4b98;--cyan:#35adff;--sky:#eaf5ff;
  --ink:#122a47;--muted:#6e8daa;--line:#d8e7f6;--card:#fff;--green:#169d66;
  --amber:#df9f18;--red:#d9535d;--purple:#7457d9;--shadow:0 18px 48px rgba(23,79,140,.13);
  --radius:22px
}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:var(--ink);background:radial-gradient(circle at 10% 0%,rgba(47,169,255,.12),transparent 24%),radial-gradient(circle at 92% 10%,rgba(81,120,226,.11),transparent 22%),linear-gradient(135deg,#eef7ff,#e9f2fd 55%,#f6faff);min-height:100vh}button,input,select{font:inherit}button{cursor:pointer}button:disabled{cursor:not-allowed;opacity:.55}

/* SIGN IN */
.auth-shell{min-height:100vh;display:grid;place-items:center;padding:24px;position:relative;overflow:hidden}.orb{position:absolute;border-radius:50%;filter:blur(1px);opacity:.42}.orb.a{width:420px;height:420px;left:-160px;top:-130px;background:radial-gradient(circle,#53baff,transparent 68%)}.orb.b{width:500px;height:500px;right:-160px;bottom:-170px;background:radial-gradient(circle,#6b80ee,transparent 68%)}
.auth-card{width:min(1050px,100%);display:grid;grid-template-columns:1.05fr .95fr;background:rgba(255,255,255,.78);backdrop-filter:blur(18px);border:1px solid rgba(255,255,255,.8);box-shadow:0 30px 90px rgba(16,67,125,.2);border-radius:30px;overflow:hidden;position:relative;z-index:1}.auth-hero{padding:44px;color:#fff;background:linear-gradient(135deg,#156fc9,#083c83);position:relative;overflow:hidden}.auth-hero:before,.auth-hero:after{content:"";position:absolute;border-radius:50%;border:1px solid rgba(255,255,255,.14)}.auth-hero:before{width:520px;height:520px;left:-250px;bottom:-300px}.auth-hero:after{width:450px;height:450px;right:-220px;top:-240px}.logo{display:flex;align-items:center;gap:12px;position:relative;z-index:2}.logo-mark{width:60px;height:60px;border-radius:18px;background:#fff;display:grid;place-items:center;color:var(--blue);box-shadow:0 10px 20px rgba(0,0,0,.12)}.logo-mark svg{width:42px;height:42px}.logo-text strong{display:block;font-size:21px;letter-spacing:-.5px}.logo-text span{display:block;font-size:11px;color:#cfe7ff;margin-top:2px}.auth-hero h1{font-size:42px;line-height:1.03;letter-spacing:-1.6px;margin:50px 0 15px;max-width:520px;position:relative;z-index:2}.auth-hero p{color:#d6eaff;max-width:500px;line-height:1.65;position:relative;z-index:2}.hero-points{display:grid;gap:12px;margin-top:28px;position:relative;z-index:2}.hero-point{display:flex;gap:11px;align-items:flex-start;padding:12px 13px;border-radius:16px;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.16)}.hero-point b{font-size:13px}.hero-point span{display:block;color:#cfe5fb;font-size:11px;margin-top:2px}.auth-form{padding:34px}.form-head h2{margin:0;font-size:28px}.form-head p{margin:7px 0 0;color:var(--muted);font-size:12px}.role-tabs{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:24px 0 18px;background:#eef5fc;padding:5px;border-radius:15px}.role-tab{border:0;background:transparent;padding:11px 10px;border-radius:11px;font-weight:900;color:#6586a4}.role-tab.active{background:#fff;color:var(--blue);box-shadow:0 6px 15px rgba(51,95,139,.09)}label{display:block;font-size:11px;font-weight:900;color:#527494;margin:14px 0 7px}.field,input,select{width:100%;border:1px solid #d7e5f2;background:#fff;border-radius:13px;padding:12px 13px;outline:none;color:var(--ink)}.field:focus,input:focus,select:focus{border-color:#7db9ec;box-shadow:0 0 0 4px #eaf6ff}.sign-btn{width:100%;border:0;border-radius:14px;padding:13px 16px;margin-top:18px;color:#fff;font-weight:1000;background:linear-gradient(135deg,#1777d3,#0b54a3);box-shadow:0 12px 22px rgba(16,91,172,.24)}.demo-box{margin-top:15px;padding:12px 13px;border-radius:14px;background:#f4f9ff;border:1px solid #dceafb;color:#6285a4;font-size:10px;line-height:1.55}.switch-note{margin-top:12px;font-size:10px;color:#8aa4bb;text-align:center}.error{margin-top:10px;color:#c3414b;font-size:11px;font-weight:800;min-height:16px}

/* APP */
.app{display:none}.topbar{position:sticky;top:0;z-index:50;height:74px;padding:0 24px;display:flex;align-items:center;justify-content:space-between;color:#fff;background:linear-gradient(105deg,#1b74cf,#0b438f);box-shadow:0 11px 28px rgba(13,67,128,.23)}.brand{display:flex;align-items:center;gap:11px}.brand .logo-mark{width:48px;height:48px;border-radius:14px}.brand .logo-mark svg{width:34px}.brand strong{font-size:18px}.brand small{display:block;font-size:10px;color:#cfe7ff;margin-top:2px}.top-actions{display:flex;align-items:center;gap:10px}.role-badge{padding:8px 11px;border-radius:999px;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.25);font-size:11px;font-weight:1000}.logout{border:1px solid rgba(255,255,255,.25);background:rgba(255,255,255,.09);color:#fff;padding:9px 12px;border-radius:11px;font-size:11px;font-weight:900}.nav{display:flex;gap:5px;overflow:auto;padding:9px 18px;background:#0f4b93;box-shadow:0 10px 24px rgba(25,75,132,.15);scrollbar-width:none}.nav::-webkit-scrollbar{display:none}.nav button{border:0;background:transparent;color:#dbeafe;padding:10px 13px;border-radius:10px;font-size:11px;font-weight:900;white-space:nowrap}.nav button.active{background:#fff;color:#145fac}.wrap{width:min(1120px,calc(100% - 30px));margin:22px auto 80px}.page-head{display:flex;justify-content:space-between;align-items:flex-end;gap:15px;margin-bottom:18px}.page-head h1{margin:0;font-size:29px;letter-spacing:-1px}.page-head p{margin:5px 0 0;color:var(--muted);font-size:12px}.section{display:flex;align-items:center;gap:11px;margin:22px 0 10px;color:#7898b8;font-size:10px;letter-spacing:2.5px;font-weight:1000}.section:before,.section:after{content:"";height:1px;flex:1;background:#ccdeef}.grid4{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.grid2{display:grid;grid-template-columns:1.2fr .8fr;gap:14px}.card{background:#fff;border:1px solid #edf4fb;border-radius:20px;padding:19px;box-shadow:var(--shadow)}.stat{background:#fff;border-radius:18px;padding:17px 12px;text-align:center;box-shadow:var(--shadow)}.stat .ico{font-size:22px}.stat strong{display:block;color:#1668ba;font-size:21px;margin-top:5px}.stat small{color:#7b9ab5;font-size:10px;font-weight:800}.pill{display:inline-flex;align-items:center;gap:6px;padding:7px 10px;border-radius:999px;background:#e4f5ec;color:#166c47;border:1px solid #b7e2c9;font-size:10px;font-weight:1000}.pill.blue{background:#e8f3ff;color:#1564ac;border-color:#c8def4}.pill.amber{background:#fff1d2;color:#8a620b;border-color:#efd58f}.headrow{display:flex;justify-content:space-between;gap:12px;align-items:flex-start}.headrow h3{margin:0;font-size:16px}.mini{margin-top:3px;color:#7a98b3;font-size:10px}.primary{border:0;padding:10px 13px;border-radius:12px;background:linear-gradient(135deg,#1675d0,#0a55a3);color:#fff;font-size:11px;font-weight:1000;box-shadow:0 8px 18px rgba(17,96,175,.2)}.secondary{border:1px solid #c9def1;padding:10px 13px;border-radius:12px;background:#f8fbff;color:#185b93;font-size:11px;font-weight:1000}.icon-btn{border:1px solid #d6e6f4;background:#fff;color:#1a609e;padding:9px 10px;border-radius:10px;font-size:11px;font-weight:900}

/* PATIENT */
.profile{display:flex;align-items:center;gap:15px}.avatar{width:68px;height:68px;border-radius:50%;display:grid;place-items:center;background:linear-gradient(145deg,#39a2f4,#1667bf);color:#fff;font-size:24px;font-weight:1000;box-shadow:0 0 0 6px #edf6ff}.profile-main{flex:1}.profile-main h2{margin:0;font-size:23px}.profile-main p{margin:4px 0 0;color:#5d83a5;font-size:12px}.chips{display:flex;gap:7px;flex-wrap:wrap;margin-top:9px}.chip{padding:6px 9px;border-radius:999px;background:#ebf5ff;border:1px solid #cfe2f7;color:#1a5e98;font-size:10px;font-weight:900}.chip.warn{background:#fff1d1;border-color:#eed383;color:#896209}.profile-side{text-align:right}.profile-side small{display:block;color:#79a0bf;margin-top:6px;font-size:10px}.service-banner{background:linear-gradient(120deg,#0f6dc6,#0b4389);color:#fff;border-radius:24px;padding:26px;position:relative;overflow:hidden}.service-banner:after{content:"";position:absolute;width:400px;height:400px;border-radius:50%;right:-180px;top:-210px;background:rgba(255,255,255,.08)}.service-banner-content{position:relative;z-index:2;display:flex;align-items:center;gap:20px}.service-visual{width:112px;height:112px;border-radius:28px;background:rgba(255,255,255,.11);border:1px solid rgba(255,255,255,.2);display:grid;place-items:center;font-size:47px}.service-banner h2{margin:0;font-size:24px}.service-banner p{margin:7px 0 0;color:#d4ebff;font-size:12px;max-width:680px;line-height:1.55}.service-meta{display:flex;gap:8px;flex-wrap:wrap;margin-top:13px}.service-chip{padding:7px 10px;border-radius:999px;background:rgba(255,255,255,.11);border:1px solid rgba(255,255,255,.18);font-size:10px;font-weight:900}.workflow-track{display:grid;grid-template-columns:repeat(5,1fr);gap:8px;margin-top:18px}.wcard{padding:13px;border-radius:14px;background:#f5f9fd;border:1px solid #e0ebf5;position:relative}.wcard.current{background:#e8f5ff;border-color:#9fcef5}.wcard b{display:block;font-size:11px}.wcard span{display:block;color:#7896b1;font-size:9px;margin-top:4px}.wtime{display:inline-flex;margin-top:9px;padding:4px 7px;border-radius:999px;background:#fff;color:#3d78aa;font-size:9px;font-weight:1000}.under40{margin-top:14px;padding:11px 13px;border-radius:14px;background:#effaf5;border:1px solid #c6e8d5;color:#196944;font-size:10px;font-weight:900;display:flex;justify-content:space-between;gap:12px}.lift{background:#061326;color:#dcecff;border-radius:20px;padding:18px}.lift-top{display:flex;justify-content:space-between;align-items:center}.lift-body{display:grid;grid-template-columns:1fr 120px;gap:20px;margin-top:16px}.floors{display:grid;gap:7px}.floor{display:flex;align-items:center;justify-content:space-between;padding:10px 12px;border-radius:11px;background:#0c1e36;border:1px solid #193352}.floor.active{background:linear-gradient(90deg,#173b5d,#12324e);border-color:#48abff;box-shadow:inset 3px 0 0 #36a5ff}.floor b{font-size:12px}.floor small{display:block;color:#7295b7;font-size:9px;margin-top:1px}.floor-no{font-size:16px;color:#43b0ff;font-weight:1000;margin-right:10px}.lift-shaft{position:relative;display:flex;justify-content:center}.shaft{width:35px;height:100%;min-height:290px;border-left:2px dashed #34506f;border-right:2px dashed #34506f;position:relative}.shaft:before{content:"LIFT";position:absolute;right:40px;top:0;color:#6c8baa;font-size:8px;letter-spacing:1px}.lift-car{position:absolute;left:50%;transform:translateX(-50%);width:52px;height:44px;border-radius:13px;background:linear-gradient(135deg,#1a83dc,#0b58a6);border:2px solid #72c8ff;display:grid;place-items:center;box-shadow:0 12px 26px rgba(21,125,218,.28);transition:top .6s}.lift-trolley{font-size:23px}.live-service{margin-top:14px;display:flex;align-items:center;gap:12px;padding:13px;border-radius:15px;background:#fff;color:var(--ink)}.person{width:50px;height:50px;border-radius:14px;background:#eaf5ff;display:grid;place-items:center;font-size:26px}.menu-cta{display:flex;justify-content:space-between;align-items:center;gap:15px;padding:16px 18px;border-radius:18px;background:linear-gradient(135deg,#f7fbff,#edf6ff);border:1px solid #d8e9f8}.menu-cta h3{margin:0;font-size:16px}.menu-cta p{margin:4px 0 0;color:#7898b3;font-size:10px;max-width:650px;line-height:1.5}.menu-ico{font-size:30px}.timeline{display:grid;gap:11px}.event{display:grid;grid-template-columns:16px 1fr auto;gap:9px;align-items:flex-start}.edot{width:10px;height:10px;margin-top:3px;border-radius:50%;background:#2baa76}.event b{font-size:11px}.event p{margin:2px 0 0;color:#7b98b2;font-size:9px}.event time{color:#4f81ad;font-size:9px;font-weight:1000}.feedback{display:flex;gap:8px;flex-wrap:wrap}.feedback button{border:1px solid #d0e0f0;background:#fff;border-radius:999px;padding:10px 14px;color:#1c5689;font-size:10px;font-weight:900}.help{padding:22px;border-radius:22px;color:#fff;background:linear-gradient(120deg,#1a71c8,#10488e)}.help h3{margin:0;font-size:24px}.help p{margin:5px 0 15px;color:#cfe7ff}.help-actions{display:flex;gap:8px;flex-wrap:wrap}.help-actions button{border:1px solid rgba(255,255,255,.3);background:rgba(255,255,255,.11);color:#fff;border-radius:12px;padding:11px 14px;font-size:10px;font-weight:900}

/* MENU */
.backdrop{display:none;position:fixed;inset:0;background:rgba(8,34,66,.44);z-index:100}.drawer{position:absolute;right:0;top:0;height:100%;width:min(620px,100%);background:#f8fbff;box-shadow:-20px 0 50px rgba(5,34,66,.18);display:flex;flex-direction:column}.drawer-head{padding:20px;border-bottom:1px solid #dbe8f4;background:#fff;display:flex;justify-content:space-between;align-items:flex-start}.drawer-head h2{margin:0}.drawer-head p{margin:5px 0 0;color:#7d99b3;font-size:10px}.close{border:0;background:#eef5fb;border-radius:10px;font-size:24px;width:38px;height:38px;color:#426b8d}.filters{display:flex;gap:7px;overflow:auto;padding:13px 16px;border-bottom:1px solid #e0ebf5}.filters button{border:1px solid #d4e4f3;background:#fff;color:#527899;border-radius:999px;padding:8px 11px;font-size:10px;font-weight:900;white-space:nowrap}.filters button.active{background:#0e63b6;color:#fff;border-color:#0e63b6}.menu-list{padding:14px 16px;overflow:auto;display:grid;gap:10px}.meal{background:#fff;border:1px solid #dceaf6;border-radius:17px;padding:14px}.meal-top{display:flex;justify-content:space-between;gap:12px;align-items:flex-start}.meal-name{font-size:13px;font-weight:1000}.meal-time{font-size:10px;color:#6286a5;margin-top:3px}.meal-meta{display:flex;gap:6px;flex-wrap:wrap;margin-top:9px}.tag{padding:5px 7px;border-radius:999px;background:#edf6ff;color:#21679c;font-size:9px;font-weight:900}.tag.kcal{background:#fff7df;color:#8a650f}.tag.protein{background:#edf9f1;color:#236d47}.items{display:grid;gap:7px;margin-top:11px}.food{display:flex;justify-content:space-between;gap:10px;align-items:center;padding:9px 10px;border-radius:11px;background:#f6faff;border:1px solid #e7f0f8}.food b{font-size:10px}.food span{display:block;color:#829eb6;font-size:9px;margin-top:2px}.food-actions{display:flex;gap:6px;align-items:center}.food-actions button{border:1px solid #cde1f2;background:#fff;color:#185b93;padding:7px 8px;border-radius:8px;font-size:9px;font-weight:900}.order-row{display:flex;gap:7px;flex-wrap:wrap;margin-top:12px}.order-row button{border:0;padding:8px 10px;border-radius:9px;font-size:9px;font-weight:1000}.early{background:#e6f3ff;color:#135fa6}.plan{background:#146dc2;color:#fff}.after{background:#fff0d1;color:#8c650c}.drawer-foot{padding:14px 16px;border-top:1px solid #dde9f4;background:#fff;color:#728fa8;font-size:9px;line-height:1.55}.drawer-foot b{color:#406b8c}

/* MANAGER */
.kpi{display:flex;align-items:center;justify-content:space-between;padding:16px 17px}.kpi .num{font-size:27px;font-weight:1000;color:#1568b8}.kpi small{color:#7896af;font-size:9px;font-weight:900}.trend{font-size:10px;font-weight:1000;color:#15925c}.manager-banner{padding:22px;border-radius:22px;color:#fff;background:linear-gradient(135deg,#0b4d9e,#1478d2)}.manager-banner h2{margin:0;font-size:24px}.manager-banner p{margin:6px 0 0;color:#cee7ff;font-size:11px}.staff-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.staff-card{background:#fff;border:1px solid #e0ebf5;border-radius:16px;padding:14px}.staff-top{display:flex;align-items:center;gap:10px}.staff-avatar{width:42px;height:42px;border-radius:12px;background:#edf6ff;display:grid;place-items:center;font-size:21px}.staff-card b{font-size:11px}.staff-card small{display:block;color:#7996b0;font-size:9px;margin-top:2px}.assign-row{display:flex;gap:7px;margin-top:11px}.assign-row select{padding:9px 10px;font-size:9px}.orders-table{width:100%;border-collapse:separate;border-spacing:0 7px}.orders-table th{text-align:left;color:#7897b3;font-size:9px;padding:0 10px}.orders-table td{background:#fff;padding:11px 10px;font-size:10px;border-top:1px solid #e4edf6;border-bottom:1px solid #e4edf6}.orders-table td:first-child{border-left:1px solid #e4edf6;border-radius:10px 0 0 10px}.orders-table td:last-child{border-right:1px solid #e4edf6;border-radius:0 10px 10px 0}.status-select{padding:7px 8px;border-radius:8px;font-size:9px}.manager-filter{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-top:13px}.manager-filter input{max-width:250px}

/* MODAL / TOAST */
.modal-backdrop{display:none;position:fixed;inset:0;z-index:120;background:rgba(4,24,48,.48);place-items:center;padding:18px}.modal{width:min(530px,100%);background:#fff;border-radius:22px;box-shadow:0 30px 70px rgba(7,33,63,.25);padding:21px}.modal h3{margin:0;font-size:18px}.modal p{color:#738fa8;font-size:10px;line-height:1.5}.modal-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:16px}.toast{display:none;position:fixed;right:18px;bottom:18px;z-index:200;background:#102b47;color:#fff;padding:12px 14px;border-radius:13px;font-size:10px;font-weight:900;box-shadow:0 15px 30px rgba(2,22,44,.25)}
@media(max-width:900px){.auth-card{grid-template-columns:1fr}.auth-hero{display:none}.grid4{grid-template-columns:repeat(2,1fr)}.grid3{grid-template-columns:1fr 1fr}.grid2{grid-template-columns:1fr}.lift-body{grid-template-columns:1fr}.lift-shaft{display:none}.workflow-track{grid-template-columns:1fr}.staff-grid{grid-template-columns:1fr}.service-banner-content{align-items:flex-start}.service-visual{width:88px;height:88px;font-size:36px}}
@media(max-width:600px){.topbar{padding:0 14px}.wrap{width:min(100% - 18px,1120px)}.page-head{align-items:flex-start;flex-direction:column}.grid4,.grid3{grid-template-columns:1fr 1fr}.profile{align-items:flex-start}.profile-side{display:none}.service-banner-content{flex-direction:column}.menu-cta{align-items:flex-start;flex-direction:column}.help-actions button{flex:1}.auth-card{border-radius:22px}.auth-form{padding:25px}.auth-hero h1{font-size:34px}}

/* PREMIUM PATIENT EXPERIENCE UPGRADE */
.journey-premium{position:relative;overflow:hidden;padding:0!important;background:linear-gradient(145deg,#ffffff 0%,#f5faff 46%,#eaf5ff 100%);border:1px solid rgba(173,210,240,.65);box-shadow:0 26px 70px rgba(16,91,155,.16)}
.journey-premium:before{content:"";position:absolute;inset:-1px;background:radial-gradient(circle at 90% 10%,rgba(53,173,255,.16),transparent 30%),radial-gradient(circle at 10% 100%,rgba(16,94,187,.1),transparent 28%);pointer-events:none}
.journey-top{position:relative;z-index:2;display:flex;align-items:flex-start;justify-content:space-between;gap:16px;padding:22px 22px 16px}
.journey-kicker{display:inline-flex;align-items:center;gap:7px;padding:7px 10px;border-radius:999px;background:#eaf6ff;color:#1564a8;border:1px solid #cfe4f6;font-size:9px;font-weight:1000;letter-spacing:.8px;text-transform:uppercase}
.live-pulse{width:8px;height:8px;border-radius:50%;background:#19b86b;box-shadow:0 0 0 0 rgba(25,184,107,.42);animation:livePulse 1.7s infinite}
.journey-title{margin:10px 0 0;font-size:24px;letter-spacing:-.8px}.journey-sub{margin:5px 0 0;color:#7592ad;font-size:10px;line-height:1.5}
.journey-summary{display:grid;grid-template-columns:auto auto;gap:8px;text-align:right}.journey-metric{padding:10px 12px;border-radius:14px;background:rgba(255,255,255,.76);border:1px solid #dfeefa;min-width:94px}.journey-metric b{display:block;color:#1666b4;font-size:18px}.journey-metric span{font-size:8px;color:#7997b1;font-weight:900}
.journey-visual{position:relative;z-index:2;margin:0 22px 18px;padding:20px;border-radius:22px;background:linear-gradient(135deg,#0b3f7b,#126dc7 55%,#0a55a3);color:#fff;overflow:hidden;box-shadow:0 20px 45px rgba(9,69,129,.24)}
.journey-visual:before{content:"";position:absolute;inset:0;background:linear-gradient(90deg,transparent 0%,rgba(255,255,255,.06) 45%,transparent 60%);transform:translateX(-100%);animation:journeyShimmer 4s infinite}
.journey-visual:after{content:"";position:absolute;width:260px;height:260px;border-radius:50%;right:-130px;top:-160px;background:rgba(255,255,255,.08)}
.journey-track{position:relative;height:112px;margin-top:8px}.journey-line{position:absolute;left:4.5%;right:4.5%;top:47px;height:4px;border-radius:999px;background:rgba(255,255,255,.18);overflow:hidden}.journey-line span{display:block;height:100%;width:90%;border-radius:inherit;background:linear-gradient(90deg,#83d4ff,#d4f2ff);box-shadow:0 0 18px rgba(160,230,255,.45);animation:progressGlow 2.5s ease-in-out infinite alternate}
