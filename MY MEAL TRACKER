let lastRipple;
document.addEventListener('pointermove', e=>{
  const b=e.target.closest('.primary,.sign-btn,.bev-order,.role-tab');
  if(b){const r=b.getBoundingClientRect();b.style.setProperty('--mx',((e.clientX-r.left)/r.width*100)+'%');b.style.setProperty('--my',((e.clientY-r.top)/r.height*100)+'%');}
});
document.addEventListener('click', e=>{
  const b=e.target.closest('.primary,.secondary,.icon-btn,.sign-btn,.bev-order,.approval-btn,.close,.feedback button,.help-actions button,.menu-cta,.role-tab');
  if(!b) return;
  const r=b.getBoundingClientRect();
  const s=document.createElement('span');
  s.className='click-ripple';
  s.style.left=(e.clientX-r.left)+'px';s.style.top=(e.clientY-r.top)+'px';
  b.style.position='relative';b.appendChild(s);
  clearTimeout(lastRipple);lastRipple=setTimeout(()=>s.remove(),520);
});

// Advanced visual: subtle 3D tilt for the hospital map canvas, following the pointer
document.addEventListener('pointermove', e=>{
  const stage=e.target.closest && e.target.closest('.v11-map-canvas');
  if(!stage) return;
  const r=stage.getBoundingClientRect();
  const px=(e.clientX-r.left)/r.width, py=(e.clientY-r.top)/r.height;
  stage.style.setProperty('--mapRy',((px-.5)*4)+'deg');
  stage.style.setProperty('--mapRx',(-(py-.5)*4)+'deg');
});
document.addEventListener('pointerleave', e=>{
  if(e.target && e.target.classList && e.target.classList.contains('v11-map-canvas')){
    e.target.style.setProperty('--mapRx','0deg'); e.target.style.setProperty('--mapRy','0deg');
  }
}, true);



