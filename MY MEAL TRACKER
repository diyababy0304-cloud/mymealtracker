<script id="v9-clarity-js">
(function(){
  /* Keep the rush-day demo realistic: 24 orders across 8 wings, exactly 2 delay-watch orders. */
  rushDaySeeded=false;
  window.ensureRushDay=function(){
    if(rushDaySeeded) return;
    orders=orders.filter(o=>!String(o.id||'').startsWith('RD-'));
    const people=['Aarav Menon','Ananya Menon','Rhea Kapoor','Vikram Shah','Isha Nair','Kabir Rao','Tara Iyer','Aditya Das','Nandita Rao','Rahul Mehta','Maya Singh','Karan Patel'];
    const times=['07:20 AM','08:05 AM','09:10 AM','11:45 AM','12:15 PM','01:05 PM','03:50 PM','07:20 PM'];
    let n=0;
    rushWings.forEach((w,wi)=>{
      for(let j=0;j<3;j++){
        const patientBase=Object.values(patients)[(wi+j)%Object.keys(patients).length];
        const delayed=(wi===1&&j===1)||(wi===5&&j===0);
        const status=delayed?(wi===1?'F&B Review':'Kitchen'):(['Order placed','Dietitian Review','F&B Queue','Kitchen','Patient','Delivered'][(wi+j)%6]);
        orders.push({
          id:`RD-${7001+n}`,patient:people[(wi*2+j)%people.length],wing:w.name,room:`${200+wi*30+j}`,
          diet:patientBase.diet,meal:['Breakfast','Lunch','Snack','Dinner'][j%4],time:times[(wi+j)%times.length],staff:w.lead,
          status,delay:delayed,approval:status==='Dietitian Review'?'Pending dietitian review':'Approved',kind:'patient',
          prep:8+(n%10),kcal:210+(n%6)*35,protein:8+(n%5)*4,priority:delayed?'Priority':'Routine',createdAt:`10:${String((n*4)%60).padStart(2,'0')}`
        }); n++;
      }
    });
    orderSeq=Math.max(orderSeq,7025); rushDaySeeded=true;
  };
  window.getRushOrders=function(){ensureRushDay();return orders.filter(o=>String(o.id||'').startsWith('RD-'));};
  window.getWingOrders=function(wing){return getRushOrders().filter(o=>o.wing===wing)};

  /* Patient meal plans: current plan + exactly two dietitian-cleared alternatives. */
  let v9SelectedPlan=0;
  function planFromCurrent(diet){
    const data=menus[diet]||menus['Diabetic Care'];
    return {name:'Current care plan',sub:'Your active meal plan',slots:data.map(m=>({time:m[0],meal:m[1],items:(m[2]||[]).map(f=>({name:f[0],prep:(String(f[1]).match(/(\d+)/)||[])[1]||'',kcal:f[2],protein:f[3]}))})),clear:true};
  }
  function planFromAlternative(diet,index){
    const a=(alternativeDietCatalog[diet]||alternativeDietCatalog['Diabetic Care'])[index];
    return {name:a.name,sub:a.sub,slots:a.slots.map(s=>({time:s[0],meal:s[0],items:[{name:s[1],prep:'',kcal:null,protein:null}]})),kcal:a.kcal,protein:a.protein,clear:true};
  }
  function planOptions(diet){return [planFromCurrent(diet),planFromAlternative(diet,1),planFromAlternative(diet,2)]}
  function planCalories(plan){return plan.slots.reduce((t,m)=>t+(m.items||[]).reduce((x,f)=>x+(Number(f.kcal)||0),0),0)}
  function planProtein(plan){return plan.slots.reduce((t,m)=>t+(m.items||[]).reduce((x,f)=>x+(Number(f.protein)||0),0),0)}
  function clearPlanCard(p,diet){
    const plans=planOptions(diet); const chosen=Math.min(v9SelectedPlan,plans.length-1); const pData=plans[chosen];
    const c=careTeamData(p);
    const cal=pData.kcal||planCalories(pData)||'—'; const prot=pData.protein||planProtein(pData)||'—';
    return `<div class="v9-plan-shell">
      <div class="v9-plan-head"><div><div class="v9-plan-kicker">PATIENT MENU CHOICE</div><h3 class="v9-plan-title">Choose what you are comfortable eating</h3><p class="v9-plan-sub">Your current plan is shown first. Two alternative plans are available when you do not prefer today's first choice. All three options carry the care-plan dietitian review record.</p></div><span class="pill blue">${escapeHtml(diet)}</span></div>
      <div class="v9-plan-tabs">${plans.map((a,i)=>`<button class="v9-plan-tab ${i===chosen?'active':''}" onclick="v9ChoosePlan(${i})"><span class="plan-num">PLAN ${String.fromCharCode(65+i)}</span><span class="plan-name">${escapeHtml(a.name)}</span><span class="plan-meta">${escapeHtml(a.sub||'Diet-specific meal choice')}</span>${i===chosen?'<span class="selected-badge">✓ SELECTED</span>':''}</button>`).join('')}</div>
      <div class="v9-plan-summary"><span>🕒 ${pData.slots.length} meal windows</span><span>🔥 ${cal} kcal</span><span>💪 ${prot} g protein</span><span>🧑‍⚕️ Dietitian-cleared</span></div>
      <div class="v9-plan-approval"><div class="mark">✓</div><div><b>Reviewed by ${escapeHtml(c.dietitian.name)}</b><span>${escapeHtml(c.dietitian.role)} · Plan ${escapeHtml(c.dietitian.version)} · ${escapeHtml(c.dietitian.approved)}</span></div></div>
      <div class="v9-meal-list">${pData.slots.map((m,mi)=>`<article class="v9-meal-block" style="animation-delay:${mi*60}ms"><div class="v9-meal-top"><div><div class="v9-meal-title">${escapeHtml(m.meal)}</div><span class="v9-meal-time">🕒 ${escapeHtml(m.time)}</span></div><div class="v9-meal-total"><b>${m.items.length}</b><span>food item${m.items.length===1?'':'s'}</span></div></div><div class="v9-food-grid">${m.items.map(f=>`<div class="v9-food"><strong>${escapeHtml(f.name)}</strong><small>${f.prep?`Preparation ${f.prep} min`:'Diet-plan serving'} </small>${(f.kcal!=null||f.protein!=null)?`<div class="v9-food-metrics">${f.kcal!=null?`<span class="kcal">${f.kcal} kcal</span>`:''}${f.protein!=null?`<span class="protein">${f.protein} g protein</span>`:''}</div>`:''}</div>`).join('')}</div><div class="v9-meal-actions"><div class="v9-order-note"><b>${chosen===0?'Scheduled care plan':'Alternative care plan'}</b><br>Order keeps the same dietitian → F&amp;B → kitchen → F&amp;B → patient journey.</div><div class="v9-order-buttons"><button class="soft-order" onclick="toast('Saved ${escapeHtml(m.meal)} as a preference')">♡ Save choice</button><button class="primary-order" onclick="v9OrderPlanMeal(${chosen},${mi})">Order this meal</button></div></div></article>`).join('')}</div>
    </div>`;
  }
  window.v9ChoosePlan=function(i){v9SelectedPlan=i;renderMenuList();}
  window.v9OrderPlanMeal=function(planIndex,mealIndex){
    if(session.role!=='patient') return;
    const p=patients[session.patientKey],diet=session.menuDiet==='All'?p.diet:session.menuDiet;const plan=planOptions(diet)[planIndex];const meal=plan.slots[mealIndex];if(!meal)return;
    const foods=meal.items.map(f=>f.name).join(' · ');const cal=meal.items.reduce((x,f)=>x+(Number(f.kcal)||0),0);const prot=meal.items.reduce((x,f)=>x+(Number(f.protein)||0),0);const c=careTeamData(p);
    openModal('Confirm meal choice',`<b>${escapeHtml(meal.meal)}</b> · ${escapeHtml(meal.time)}<br><br><strong>Food items:</strong> ${escapeHtml(foods)}<br><br>${cal?`${cal} kcal · `:''}${prot?`${prot} g protein`:''}<br><br>Dietitian-cleared: ${escapeHtml(c.dietitian.name)} · ${escapeHtml(c.dietitian.version)}.<br>This request follows the patient meal service journey.`,()=>{orders.unshift({id:`ML-${orderSeq++}`,patient:p.name,diet:p.diet,meal:`${meal.meal} · ${foods}`,time:meal.time,status:'F&B Review',staff:p.service,kind:'patient',approval:`Dietitian cleared · ${c.dietitian.name}`,approvedBy:c.dietitian.name});closeModal();toast(`${meal.meal} ordered · ${plan.name} selected`);renderMain()});
  }

  /* Replace patient scheduled meal menu with the clearer 3-plan experience. */
  const basePatientMenuRender=renderMenuList;
  window.renderMenuList=function(){
    if(session.role==='patient' && session.menuMode==='meals'){
      const p=patients[session.patientKey],diet=session.menuDiet==='All'?p.diet:session.menuDiet,host=document.getElementById('menuList');if(!host)return;
      host.innerHTML=menuHeaderBlock(diet,p)+clearPlanCard(p,diet);
      return;
    }
    if(session.role==='patient' && session.menuMode==='alternatives'){
      session.menuMode='meals';v9SelectedPlan=Math.max(1,v9SelectedPlan);renderMenuList();return;
    }
    basePatientMenuRender();
  };

  /* Focused manager portal: only useful operational choices remain. */
  window.renderNav=function(){
