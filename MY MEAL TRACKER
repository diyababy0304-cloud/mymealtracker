    rec.onerror=e=>{window.voiceListening=false;if(card)card.classList.remove('listening');const msg=e.error==='not-allowed'?'Microphone permission is required.':'Voice stopped — try again.';if(state){state.textContent=msg;state.className='voice-state warn'}updateQvmStatus(msg,'warn');};
    rec.onend=()=>{window.voiceListening=false;if(card)card.classList.remove('listening')};
    try{rec.start()}catch(_){window.voiceListening=false;if(card)card.classList.remove('listening');updateQvmStatus('Voice could not start. Tap Speak now and try again.','warn')}
  };

  const originalProcess=window.processVoiceOrder;
  window.processVoiceOrder=function(text){
    const p=session.role==='patient'?patients[session.patientKey]:null;if(!p)return;
    const q=String(text||'').toLowerCase();
    if(q.includes('show menu')||q.includes('menu')){updateQvmStatus('Opening the full menu for your approved diet…','ok');setTimeout(()=>{window.qvmOpenFullMenu()},260);return;}
    const candidates=getVoiceCandidates(p);let best=null,score=0;for(const item of candidates){const tokens=item.name.toLowerCase().split(/[^a-z0-9]+/).filter(x=>x.length>2);const s=tokens.reduce((n,t)=>n+(q.includes(t)?1:0),0);if(s>score){score=s;best=item}}
    if(!best){updateQvmStatus(`I heard “${text}” but could not confidently match it. Choose an item from the visible menu.`,'warn');return}
    updateQvmStatus(`Matched: ${best.name}. Checking the order details before confirmation…`,'ok');
    setTimeout(()=>openModal('Confirm voice order',`${p.name}: ${best.name}. Planned time ${best.time||'as requested'} · Prep ${best.prep||'—'} min · ${best.kcal||'—'} kcal · ${best.protein||'—'} g protein. This patient request will follow the dietitian-review checkpoint before F&B.`,()=>{if(typeof placeVoiceOrder==='function')placeVoiceOrder(best)}),260);
  };

  document.addEventListener('keydown',e=>{if(e.key==='Escape')window.qvmCloseVoiceMenu()});
})();
</script>


