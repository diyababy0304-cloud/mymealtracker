  window.deptAdvance=function(id,stage){const os=loadOrders();const o=os.find(x=>x.id===id);if(!o)return;o.events.push({stage,time:nowIso()});saveOrders(os);};
  window.deptApproveDiet=function(id){const sel=document.getElementById('dietSel_'+id);const who=sel?sel.value:DIETITIANS[0];const os=loadOrders();const o=os.find(x=>x.id===id);if(!o)return;o.dietitianBy=who;o.events.push({stage:'dietitian_approved',time:nowIso()});saveOrders(os);};
  window.deptFnbAccept=function(id){const sel=document.getElementById('fnbSel_'+id);const who=sel?sel.value:FNB_STAFF[0];const os=loadOrders();const o=os.find(x=>x.id===id);if(!o)return;o.fnbBy=who;o.events.push({stage:'fnb_received',time:nowIso()});saveOrders(os);};
  window.deptReject=function(id){const os=loadOrders();const i=os.findIndex(x=>x.id===id);if(i>-1)os.splice(i,1);saveOrders(os);};
  window.deptStartCooking=function(id){const sel=document.getElementById('chefSel_'+id);const chef=sel?sel.value:CHEFS[0];const os=loadOrders();const o=os.find(x=>x.id===id);if(!o)return;o.chef=chef;o.events.push({stage:'kitchen_cooking',time:nowIso()});saveOrders(os);};
  window.deptSimulateRush=function(){
    const os=loadOrders();
    let maxId=Math.max(2000,...os.map(o=>o.id));
    const n=10;
    for(let i=0;i<n;i++){
      const p=RUSH_POOL[Math.floor(Math.random()*RUSH_POOL.length)];
      maxId++;
      os.push({id:maxId,patient:p.name,room:p.room,meal:p.meal,diet:p.diet,chef:null,events:[{stage:'placed',time:nowIso()}]});
    }
    saveOrders(os);
  };
  window.deptShift=function(){
    const sel=document.getElementById('shiftSel');
    if(!sel)return;
    deptSwitchTo(sel.value);
  };
  window.deptSwitchTo=function(role){
    if(!DEPT_ROLES.includes(role))return;
    session.role=role;
    session.section='home';
    const badge=document.getElementById('roleBadge');
    if(badge)badge.textContent=`${DEPT_META[role].icon} ${DEPT_META[role].label}`;
    renderNav();renderMain();
    window.scrollTo({top:0,behavior:'smooth'});
  };

  function alertsFor(orders){
    const msgs={placed:'Dietitian approval overdue',dietitian_approved:'F&B acceptance overdue',fnb_received:'Sending to kitchen is overdue',
      kitchen_queued:'Kitchen acknowledgement overdue',kitchen_cooking:'Preparation delay detected',food_ready:'Ready order awaiting F&B pickup from kitchen'};
    const out=[];
    orders.forEach(o=>{const s=STAGES[IDX[curStage(o)]];if(s.id==='fnb_delivered')return;const m=minsAgo(lastTime(o));if(m>s.thr)out.push(`⚠️ ${o.patient} · Room ${o.room} — ${msgs[s.id]||'Stage overdue'} (${Math.round(m)} min)`);});
    return out;
  }
  function pill(o){const s=statusOf(o);const map={green:'🟢 on track',amber:'🟡 watch',red:'🔴 overdue',grey:'⚪ done'};return `<span class="pill ${s}">${map[s]}</span>`;}
  function orderMeta(o,startStage,startLbl){
    const mi=MEAL_INFO[o.meal]||{kcal:'—',protein:'—',allergy:'No allergy notes'};
    const startT=startStage?evTime(o,startStage):null;
    let extra='';
    if(o.dietitianBy)extra+=` · 🥗 ${o.dietitianBy}`;
    if(o.fnbBy)extra+=` · 📦 ${o.fnbBy}`;
    if(o.chef)extra+=` · 👨‍🍳 ${o.chef}`;
    return `<small>${o.meal} — ${o.diet} · ${mi.kcal} kcal · ${mi.protein} protein${extra}<br>⚠️ ${mi.allergy} &nbsp;·&nbsp; ${startLbl&&startT?`${startLbl}: <b>${startT}</b>`:`Since ${fmt(lastTime(o))}`}</small>`;
  }
  function queueBlock(title,orders,stageId,btnFn,startStage,startLbl){
    const list=orders.filter(o=>curStage(o)===stageId);
    return `<section class="dept-lane dept-lane-${stageId}"><header class="dept-lane-head"><span class="dept-lane-mark">${stageId==='placed'?'01':stageId==='dietitian_approved'?'01':stageId==='fnb_received'?'02':stageId==='kitchen_queued'?'01':stageId==='kitchen_cooking'?'02':'03'}</span><div><b>${title}</b><small>${list.length} order${list.length===1?'':'s'} in this step</small></div><span class="dept-lane-count">${list.length}</span></header><div class="dept-lane-body">`+(list.length?list.map(o=>`
      <div class="dept-order"><div class="dept-order-top"><div><b>${o.patient} · Room ${o.room}</b>${orderMeta(o,startStage,startLbl)}</div>${pill(o)}</div>
      <div class="dept-btnrow">${btnFn(o)}</div></div>`).join(''):'<p class="dept-empty">Nothing waiting here.</p>')+`</div></section>`;
  }

  function shiftControl(){
    const others=DEPT_ROLES.filter(r=>r!==session.role);
    return `<div class="dept-shift"><span>🔁 Shift to:</span>
      <select id="shiftSel">${others.map(r=>`<option value="${r}">${DEPT_META[r].icon} ${DEPT_META[r].label}</option>`).join('')}</select>
      <button onclick="deptShift()">Go</button>
      <button class="dept-rush" onclick="deptSimulateRush()">🚨 Simulate rush hour (+10 orders)</button></div>`;
  }

  function renderDeptPortal(){
    if(!DEPT_ROLES.includes(session?.role))return;
    const host=document.getElementById('deptHome');
    if(!host)return;
    host.dataset.role=session.role;
    const orders=loadOrders();
    const meta=DEPT_META[session.role];
    let body='';
    if(session.role==='dietitian'){
      body=`<div class="dept-workspace portal-dietitian"><aside class="dept-work-aside"><span class="dept-aside-icon">✚</span><b>Clinical review desk</b><p>Check the meal against the patient’s active diet and allergy notes before approval.</p><span class="dept-aside-tag">PATIENT SAFETY FIRST</span></aside><div class="dept-work-main">${queueBlock('Awaiting clinical review',orders,'placed',o=>`<select class="dept-select" id="dietSel_${o.id}">${DIETITIANS.map(d=>`<option>${d}</option>`).join('')}</select><button class="dept-approve" onclick="deptApproveDiet(${o.id})">APPROVE</button><button class="dept-reject" onclick="deptReject(${o.id})">REJECT</button>`,'placed','Placed')}</div></div>`;
    }else if(session.role==='fnb'){
      body=`<div class="dept-workspace portal-fnb">${queueBlock('Approved · accept',orders,'dietitian_approved',o=>`<select class="dept-select" id="fnbSel_${o.id}">${FNB_STAFF.map(f=>`<option>${f}</option>`).join('')}</select><button class="dept-approve" onclick="deptFnbAccept(${o.id})">ACCEPT ORDER</button>`,'dietitian_approved','Approved')}${queueBlock('Accepted · send',orders,'fnb_received',o=>`<button class="dept-approve" onclick="deptAdvance(${o.id},'kitchen_queued')">SEND TO KITCHEN</button>`,'fnb_received','Accepted')}${queueBlock('Ready · receive',orders,'food_ready',o=>`<button class="dept-approve" onclick="deptAdvance(${o.id},'fnb_delivered')">RECEIVED FROM KITCHEN</button>`,'food_ready','Food ready')}</div>`;
    }else if(session.role==='kitchen'){
      body=`<div class="dept-workspace portal-kitchen"><div class="dept-kitchen-banner"><span>🍳</span><div><b>Kitchen production line</b><small>Prepare in order, verify the tray, then mark it ready for collection.</small></div></div><div class="dept-kitchen-lanes">${queueBlock('Next to prepare',orders,'kitchen_queued',o=>`<select class="dept-select" id="chefSel_${o.id}">${CHEFS.map(c=>`<option>${c}</option>`).join('')}</select><button class="dept-approve" onclick="deptStartCooking(${o.id})">START PREPARATION</button>`,'kitchen_queued','Received')}
         ${queueBlock('On the stove',orders,'kitchen_cooking',o=>`<button class="dept-approve" onclick="deptAdvance(${o.id},'food_ready')">FOOD READY</button>`,'kitchen_cooking','Started')}</div></div>`;
    }
    const alerts=alertsFor(orders);
    const active=orders.filter(o=>curStage(o)!=='fnb_delivered').length;
    const delivered=orders.filter(o=>curStage(o)==='fnb_delivered').length;
    host.innerHTML=`
      <div class="dept-hero"><span class="dept-live"><span class="dept-dot"></span> LIVE · ${meta.label} PORTAL</span>
        <h1>${meta.icon} ${meta.label} queue</h1>
        <p>Signed in as ${escapeSafe(session.staffName||meta.label)}. Every button you press writes a real start/stop timestamp into the shared meal journey — the patient and manager see it immediately.</p>
        <p><b>Service commitment: complete every meal journey within 36 minutes.</b></p>
        ${shiftControl()}</div>
      <div class="dept-kpis">
        <div class="dept-kpi"><strong>${active}</strong><small>ACTIVE ORDERS</small></div>
        <div class="dept-kpi"><strong>${delivered}</strong><small>RECEIVED BY F&amp;B TODAY</small></div>
        <div class="dept-kpi"><strong>${alerts.length}</strong><small>OPEN ALERTS</small></div>
        <div class="dept-kpi"><strong>${orders.length}</strong><small>TOTAL ORDERS</small></div>
      </div>
      ${alerts.length?`<div class="section">EXCEPTION ALERTS</div>`+alerts.map(a=>`<div class="dept-alert">${a}</div>`).join(''):''}
      ${body}
    `;
  }
  function escapeSafe(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}

  // --- fix: guarantee the sign-in card is never left invisible ---
  // The sign-in fields fade in via a CSS animation (opacity 0 -> 1). If that
  // animation ever fails to run to completion — reduced-motion settings,
  // a bfcache restore, or quirks in the copy Safari opens from a WhatsApp
  // temp file — the whole right-hand panel can stay stuck at opacity:0,
  // which looks like a blank screen with no login fields at all. This
  // force-reveals every element in the sign-in card a moment after any
  // switch/logout, without touching the existing HTML or CSS.
  function deptForceAuthVisible(){
    const shell=document.getElementById('signInPage');
    if(!shell)return;
    shell.querySelectorAll(
      '.auth-card,.auth-hero,.auth-hero>*,.hero-point,.auth-form,.auth-form>*,.role-tab,'+
      '#patientLogin,#patientLogin *,#attenderLogin,#attenderLogin *,#managerLogin,#managerLogin *,'+
      '#dietitianLogin,#dietitianLogin *,#fnbLogin,#fnbLogin *,#kitchenLogin,#kitchenLogin *'
    ).forEach(el=>{el.style.opacity='1';el.style.transform='none';});
  }
  window.addEventListener('pageshow',deptForceAuthVisible);
  document.addEventListener('DOMContentLoaded',()=>setTimeout(deptForceAuthVisible,50));
  setTimeout(deptForceAuthVisible,50);

  // --- wire logins additively, without touching the original patient/attender/manager flow ---
  const _switchLogin=window.switchLogin;
  window.switchLogin=function(role){
    _switchLogin(role);
    DEPT_ROLES.forEach(r=>{
      const el=document.getElementById(r+'Login');
      if(el)el.style.display=(role===r)?'block':'none';
      if(role===r){
        // defensive: if the PIN field somehow ended up blank, restore the demo default
        const pf=document.getElementById(r+'Pin');
        if(pf && !pf.value.trim())pf.value=DEPT_META[r].pin;
      }
    });
    setTimeout(deptForceAuthVisible,900);
  };
  DEPT_ROLES.forEach(r=>{
    const fn='login'+r.charAt(0).toUpperCase()+r.slice(1);
    window[fn]=function(){
      const pinField=document.getElementById(r+'Pin');
      const raw=(pinField.value||'').trim();
      const pin=raw===''?DEPT_META[r].pin:raw; // blank field falls back to the demo PIN instead of hard-failing
      if(pin!==DEPT_META[r].pin){document.getElementById('loginError').textContent=`Use the demo ${DEPT_META[r].label} PIN ${DEPT_META[r].pin}.`;return;}
      const nameEl=document.getElementById(r+'Name');
      session={role:r,patientKey:null,attenderKey:null,staffName:nameEl?nameEl.value:DEPT_META[r].label,section:'home',menuDiet:'All',menuMode:'meals',attenderCategory:'Breakfast',__mealPlan:'A'};
      enterApp();
    };
  });
  const _enterApp=window.enterApp;
  window.enterApp=function(){
    _enterApp();
    if(DEPT_ROLES.includes(session.role)){
      document.getElementById('roleBadge').textContent=`${DEPT_META[session.role].icon} ${DEPT_META[session.role].label}`;
    }
  };
  // fix: after signing out of a department portal, reopen that same department's tab/panel
  // (instead of silently resetting to the Patient tab) so the same credentials are easy to use again
  const _logout=window.logout;
  window.logout=function(){
    const wasDeptRole=DEPT_ROLES.includes(session?.role)?session.role:null;
    _logout();
    if(wasDeptRole)switchLogin(wasDeptRole);
    setTimeout(deptForceAuthVisible,50);
    setTimeout(deptForceAuthVisible,900);
  };
  const _renderNav=window.renderNav;
  window.renderNav=function(){
    if(DEPT_ROLES.includes(session?.role)){
      const nav=document.getElementById('mainNav');
      if(nav)nav.innerHTML=`<button class="active">${DEPT_META[session.role].icon} ${DEPT_META[session.role].label} queue</button>`;
      return;
    }
    return _renderNav.apply(this,arguments);
  };
  const _renderMain=window.renderMain;
  window.renderMain=function(){
    const dp=document.getElementById('deptPortal');
    if(DEPT_ROLES.includes(session?.role)){
      document.getElementById('patientPortal').style.display='none';
      document.getElementById('attenderPortal').style.display='none';
      document.getElementById('managerPortal').style.display='none';
      if(dp)dp.style.display='block';
      renderDeptPortal();
      return;
    }
    if(dp)dp.style.display='none';
    return _renderMain.apply(this,arguments);
  };
  window.addEventListener('storage',e=>{if(e.key===DKEY&&DEPT_ROLES.includes(session?.role))renderDeptPortal();});
  setInterval(()=>{if(DEPT_ROLES.includes(session?.role))renderDeptPortal();},5000);
})();
</script>
