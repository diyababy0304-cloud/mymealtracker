  }
  function loadOrders(){try{const raw=localStorage.getItem(DKEY);if(!raw){const s=seed();localStorage.setItem(DKEY,JSON.stringify(s));return s;}const saved=JSON.parse(raw);if(!Array.isArray(saved))throw new Error('Invalid saved orders');const rename={sadiya:'Ananya',vinay:'Naveen',supriya:'Aditi',farooq:'Dhruv',ibrahim:'Karthik'};let changed=false;saved.forEach(o=>{const n=rename[String(o.patient||'').toLowerCase()];if(n){o.patient=n;changed=true}});if(changed)localStorage.setItem(DKEY,JSON.stringify(saved));return saved;}catch(e){const s=seed();localStorage.setItem(DKEY,JSON.stringify(s));return s;}}
