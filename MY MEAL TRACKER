      <div class="section">INDIVIDUAL FOODS · DIETITIAN REVIEW PATH</div><div class="individual-grid">${ind.map(f=>`<div class="individual-item"><div><div class="individual-name">${escM(f.name)}</div><div class="individual-kind">${escM(f.kind)} · ${escM(f.time)}</div><div class="individual-tags"><span class="tag">Prep ${f.prep} min</span><span class="tag kcal">${f.kcal} kcal</span><span class="tag protein">${f.protein} g P</span><span class="tag approval-tag">✓ ${escM(c.name)}</span></div></div></div>`).join('')}</div>
      <div class="section">TEA · COFFEE · JUICES · ${bev.length}</div><div class="beverage-grid">${bev.map(f=>`<div class="beverage-card"><div class="bev-icon">${f.icon}</div><div><div class="bev-name">${escM(f.name)}</div><div class="bev-note">${escM(f.note)} · ${escM(f.time)}</div><div class="bev-stats"><span class="tag">Prep ${f.prep} min</span><span class="tag kcal">${f.kcal} kcal</span><span class="tag protein">${f.protein} g P</span></div></div></div>`).join('')}</div></div>`;
  }
  window.selectManagerDietV21=function(diet){session.managerDiet=diet; renderManagerSection(); setTimeout(()=>document.querySelector('.v21-diet-tab.active')?.scrollIntoView({block:'nearest',inline:'nearest'}),20); toast(`${diet} menu opened`)};
  // Replace the local global function used by renderMain/renderManagerSection.
  if(typeof managerMenu==='function') managerMenu=managerMenuV21;
  window.managerMenu=managerMenuV21;
  const prev = window.renderManagerSection;
  window.renderManagerSection=function(){ if(session.role==='manager'&&session.section==='menu'){ setManagerPageTitle('Menu Planning','All seven diet plans with dietitian-cleared foods, individual items and beverages.'); document.getElementById('managerHome').innerHTML=managerMenuV21(); return; } return typeof prev==='function'?prev.apply(this,arguments):undefined; };
