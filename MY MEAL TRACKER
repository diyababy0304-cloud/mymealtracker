  };
  const RUSH_POOL=[
    {name:'Kiran',room:'201',diet:'Cardiac Low-Sodium',meal:'Cardiac Low-Sodium Bowl'},
    {name:'Divya',room:'506',diet:'Renal-Friendly',meal:'Renal-Friendly Khichdi'},
