  }
  function individualCatalog(p,diet){const a=approvalForDiet(diet),list=individualMenus[diet]||[];return `<div class="catalog-intro"><b>Individual patient foods</b><br>Each item is reviewed through the dietitian checkpoint before F&B.</div><div class="individual-grid">${list.map((f,i)=>`<div class="individual-item filterable-menu-item"><div><div class="individual-name">${esc(f.name)}</div><div class="individual-kind">${esc(f.kind)} · ${esc(f.time)}</div><div class="individual-tags"><span class="tag">Prep ${f.prep} min</span><span class="tag kcal">${f.kcal} kcal</span><span class="tag protein">${f.protein} g protein</span><span class="tag approval-tag">✓ ${esc(a.name)}</span></div></div><div class="individual-actions"><button class="approval-btn approved" onclick="v22OrderIndividual(${i})">Request / order</button></div></div>`).join('')}</div>`}
