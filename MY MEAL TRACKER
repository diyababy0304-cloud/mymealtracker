function menuHeaderBlock(diet,p){const primary=diet==='All'?(p?.diet||'Diabetic Care'):diet,m=dietMeta[primary]||dietMeta['Diabetic Care'],data=menus[primary]||[],foodCount=data.reduce((n,x)=>n+x[2].length,0),ind=(individualMenus[primary]||[]).length,bev=(beverageMenus[primary]||[]).length;return `<div class="menu-command"><div class="menu-command-title"><div class="diet-orb ${m.cls}">${m.icon}</div><div><h3>${escapeHtml(primary)} · Clear Menu Plan</h3><p>${escapeHtml(m.desc)} The patient sees <b>serving time · prep time · kcal · protein</b> before ordering.</p><div class="menu-command-stats"><span>${data.length} planned windows</span><span>${foodCount} scheduled foods</span><span class="green">${ind} individual foods</span><span class="purple">${bev} beverages</span></div></div></div><div class="menu-tools"><input class="menu-search" id="patientMenuSearch" placeholder="Search food or beverage…" oninput="filterVisibleMenu()"><button class="secondary" onclick="toast('Menu synced to active diet plan')">✓ Synced</button></div></div><div class="menu-helper"><div class="helper-card"><b>🕒 Timing</b><span>Early · planned-time · after-meal ordering stays visible.</span></div><div class="helper-card"><b>🧑‍⚕️ Safety</b><span>Individual foods and beverages show the dietitian checkpoint.</span></div><div class="helper-card"><b>📊 Transparency</b><span>Preparation, kcal and protein stay visible before order.</span></div></div>`}
