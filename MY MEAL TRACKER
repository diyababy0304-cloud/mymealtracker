<script id="v22-menu-final-fix">
(function(){
  const diets=['Diabetic Care','Cardiac Low-Sodium','Renal-Friendly','High-Protein Soft','Liquid Diet','Pureed Soft Diet','Vegetarian High-Protein'];
  const fallbackPatient=()=>session?.patientKey?patients[session.patientKey]:null;
  function esc(v){return typeof escapeHtml==='function'?escapeHtml(v):String(v??'').replace(/[&<>'\"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','\"':'&quot;'}[c]));}
  function approvalForDiet(diet){
    const p=Object.values(patients).find(x=>x.diet===diet)||Object.values(patients)[0];
    const c=typeof careTeamData==='function'?careTeamData(p):null;
    return {patient:p,name:c?.dietitian?.name||'Assigned Clinical Dietitian',role:c?.dietitian?.role||'Clinical Dietitian',version:c?.dietitian?.version||'DEMO-1.0',approved:c?.dietitian?.approved||'Approval record available for demo'};
  }
  function primaryPlan(diet){
    const rows=(menus[diet]||[]).map(m=>({meal:m[1],time:m[0],items:(m[2]||[]).map(f=>({name:f[0],detail:f[1],kcal:f[2],protein:f[3]}))}));
    return {code:'A',name:'Plan A · Current Care Plan',sub:'Current dietitian-linked plan',rows};
  }
  function altPlan(diet,index){
    const src=((alternativeDietCatalog[diet]||[])[index-1])||{name:`Alternative Plan ${index}`,sub:'Diet-specific alternative',slots:[]};
    const base=(menus[diet]||[]); const rows=(src.slots||[]).map((s,i)=>({meal:s[0],time:(base[i]||[])[0]||['7:30 AM','10:30 AM','12:30 PM','4:00 PM','7:30 PM'][i],items:String(s[1]||'').split(/\s*\+\s*/).map(name=>({name,detail:'Dietitian-cleared plan item'}))}));
    return {code:index===1?'B':'C',name:`Plan ${index===1?'B':'C'} · ${src.name}`,sub:src.sub,rows,totalKcal:src.kcal,totalProtein:src.protein};
  }
  function planFor(diet,code){return code==='A'?primaryPlan(diet):altPlan(diet,code==='B'?1:2)}
  function planTabs(diet,active,context){
    const a=primaryPlan(diet),b=altPlan(diet,1),c=altPlan(diet,2); const all=[a,b,c];
    return `<div class="v22-plan-row">${all.map(p=>`<button class="v22-plan-card ${p.code===active?'active':''}" onclick="${context==='drawer'?'v22SelectDrawerPlan':'v22SelectInlinePlan'}('${p.code}')"><span class="v22-plan-code">${p.code==='A'?'CURRENT CARE PLAN':'ALTERNATIVE CARE PLAN'}</span><span class="v22-plan-name">${esc(p.name)}</span><span class="v22-plan-meta">${esc(p.sub)}<br>${p.rows.length} meal windows · ${p.rows.reduce((n,m)=>n+m.items.length,0)} food items</span><span class="v22-plan-ok">✓ Dietitian-cleared</span>${p.code===active?'<span class="v22-selected">SELECTED</span>':''}</button>`).join('')}</div>`;
  }
  function techHeader(diet){const meta=dietMeta[diet]||{};return `<div class="v22-menu-tech"><div class="v22-tech-orb">${meta.icon||'✦'}</div><div><b>NANO FLOW MENU · ${esc(diet)}</b><span>Reveal exact foods, timing and nutrition with a calm step-by-step menu experience.</span></div><div class="v22-signal"><i></i>READY</div></div>`}
  function approvalBanner(diet){const a=approvalForDiet(diet);return `<div class="v22-diet-approval"><div style="display:flex;align-items:center;gap:10px"><div class="seal">✓</div><div><b>Dietitian approval recorded</b><span>${esc(a.name)} · ${esc(a.role)} · Plan ${esc(a.version)} · ${esc(a.approved)}</span></div></div><span class="pill">Approved menu</span></div>`}
  function renderRows(plan){
    return `<div class="v22-food-grid">${plan.rows.map((m,mi)=>`<article class="v22-meal-panel" style="animation-delay:${mi*70}ms"><h4>${esc(m.meal)}</h4><span class="time">🕒 Planned serving · ${esc(m.time)}</span>${m.items.map(f=>`<div class="v22-food-item"><div><b>${esc(f.name)}</b><small>${esc(f.detail||'Diet-plan item')}</small></div>${f.kcal!=null||f.protein!=null?`<div class="v22-metrics">${f.kcal!=null?`<i class="k">${f.kcal} kcal</i>`:''}${f.protein!=null?`<i class="p">${f.protein} g P</i>`:''}</div>`:''}</div>`).join('')}<div class="v22-meal-foot"><small>${plan.code==='A'?'Current care plan':'Alternative plan'} · Dietitian-cleared</small><button class="v22-order" onclick="v22OrderMeal('${plan.code}',${mi})">Order this meal</button></div></article>`).join('')}</div>`;
  }
  function patientWorkspace(p,mode){
    const diet=session.menuDiet==='All'?p.diet:session.menuDiet; const active=session.__mealPlan||'A'; const plan=planFor(diet,active);
    const modes=`<div class="menu-mode-tabs v22-modes"><button class="${mode==='meals'?'active':''}" onclick="v22SetMode('meals')">🍽️ Scheduled Meals</button><button class="${mode==='individual'?'active':''}" onclick="v22SetMode('individual')">🥣 Individual Foods</button><button class="${mode==='beverages'?'active':''}" onclick="v22SetMode('beverages')">☕ Tea · Coffee · Juices</button></div>`;
    let body='';
