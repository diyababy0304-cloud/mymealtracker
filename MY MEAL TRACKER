      return;
    }
    if(window.voiceListening && window.voiceRecognition){window.voiceRecognition.stop();updateQvmStatus('Voice stopped — tap Speak now to continue.');return;}
    const rec=new Speech();window.voiceRecognition=rec;window.voiceListening=true;rec.lang='en-IN';rec.interimResults=true;rec.continuous=false;
    if(card)card.classList.add('listening');if(state){state.textContent='Listening… say the food or drink you want.';state.className='voice-state ok'}
