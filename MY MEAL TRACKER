    {name:'Prakash',room:'361',diet:'Diabetic',meal:'Diabetic Thali'},
    {name:'Geetha',room:'447',diet:'Cardiac Low-Sodium',meal:'Cardiac Low-Sodium Bowl'}
  ];
  const DKEY='mmt_dept_orders_v3';

  function nowIso(){return new Date().toISOString();}
