  function pts(s){const m=routeMetrics(s);return [[s.x,s.y],[24,78],[38,63],m.d]}
  function routePath(s){return pts(s).map(p=>p.join(',')).join(' ')}
  function mapDepartments(){return depts.map(d=>`<button class="v20-dept ${d[3]}" data-v20="dept" data-dest="${d[0]}" style="left:${d[4]}%;top:${d[5]}%;border-color:${deptColor[d[3]]||'#6aa9cc'}66"><b>${esc(d[1])}</b><span>${esc(d[2])}</span></button>`).join('')}
  function statusDot(st){return st==='Delivering'?'delivering':st==='Returning'?'returning':st==='Waiting for Food'?'waiting':st==='In Patient Room'?'patient':'lobby'}
  function managerMap(){
    const s=current(), vis=filtered(), path=routePath(s), metrics=routeMetrics(s), selectedDest=destName(s);
    const staffHtml=vis.map(x=>`<button class="v20-staff ${x.color} ${x.name===s.name?'selected':''}" data-v20="staff" data-id="${x.id}" style="left:${x.x}%;top:${x.y}%" title="${esc(x.name)} · ${esc(x.status)}">${initials(x.name)}<b>${esc(x.name.split(' ')[0])}</b></button>`).join('');
    const rows=vis.map(x=>`<button class="v20-staff-row ${x.name===s.name?'active':''}" data-v20="staff" data-id="${x.id}"><span class="v20-avatar" style="background:linear-gradient(145deg,${x.color==='delivering'?'#139af0':x.color==='returning'?'#8a66ff':x.color==='waiting'?'#e49a28':x.color==='patient'?'#1cc28b':'#547f99'},#10273f)">${initials(x.name)}</span><span><b>${esc(x.name)}</b><span>${esc(x.status)} · ${esc(x.wing)} · F${x.floor} · ${esc(x.ward)}</span></span><i class="v20-status-dot ${statusDot(x.status)}"></i></button>`).join('');
    const destLabel=s.dest;
    return `<section class="v20-map-shell"><div class="v20-map-head"><div><div class="v20-map-kicker"><i></i> Manager live movement map · indoor operations</div><div class="v20-map-title">Live Staff Navigation</div><div class="v20-map-sub">Real-time style operational view of food-service staff positions. Select a staff member to trace their route through the hospital, inspect wing / floor / ward and follow the next handoff.</div></div><span class="v20-live-badge">● LIVE TEAM · ${team.length}</span></div>
      <div class="v20-map-kpis"><div class="v20-kpi"><b>${team.length}</b><span>Staff on map</span></div><div class="v20-kpi"><b>${team.filter(x=>x.status==='Delivering').length}</b><span>Delivering</span></div><div class="v20-kpi"><b>${team.filter(x=>x.status==='Returning').length}</b><span>Returning</span></div><div class="v20-kpi"><b>${team.filter(x=>x.status==='Waiting for Food').length}</b><span>Waiting</span></div><div class="v20-kpi"><b>${team.filter(x=>x.status==='In Patient Room').length}</b><span>At patient</span></div></div>
      <div class="v20-map-toolbar"><input class="v20-toolbar-search" id="v20MapSearch" placeholder="Search staff / wing / ward"><select class="v20-toolbar-select" id="v20MapStatus"><option>All</option><option>Delivering</option><option>Returning</option><option>Waiting for Food</option><option>In Patient Room</option><option>Near Lobby</option></select><select class="v20-toolbar-select" id="v20MapFloor"><option>All</option><option>B1 / -1</option><option>0</option><option>1</option><option>2</option><option>3</option><option>4</option><option>5</option><option>6</option></select><button class="v20-toolbar-btn ${mapState.showDept?'active':''}" data-v20="toggleDept">Departments</button><button class="v20-toolbar-btn ${mapState.showRoutes?'active':''}" data-v20="toggleRoutes">Routes</button><button class="v20-toolbar-btn ${mapState.showHeat?'active':''}" data-v20="toggleHeat">Heat zones</button><button class="v20-toolbar-btn active" data-v20="toggle3d">3D depth</button><button class="v20-toolbar-btn" data-v20="zoomOut">−</button><button class="v20-toolbar-btn" data-v20="zoomIn">+</button><button class="v20-toolbar-btn" data-v20="center">Center</button><button class="v20-toolbar-btn" data-v20="reset">Reset</button></div>
      <div class="v20-map-content"><div class="v20-map-stage" id="v20MapStage"><div class="v20-scene ${mapState.show3d?"v20-depth-on":"v20-depth-off"}" id="v20Scene" style="transform:scale(${mapState.zoom})"><div class="v20-road r1"></div><div class="v20-road r2"></div><div class="v20-road r3"></div><div class="v20-road r4"></div><div class="v20-building kitchen"><b>Central Kitchen</b><span>Meal production · pack · dispatch</span></div><div class="v20-building fb"><b>F&amp;B Hub</b><span>Tray verification · handoff</span></div><div class="v20-building clinical"><b>Clinical Tower</b><span>ICU · Wings A/B/C · patient rooms</span></div><div class="v20-building lobby"><b>Main Lobby</b><span>Waiting · Billing · Information</span></div><div class="v20-building canteen"><b>Canteen</b><span>Patient · Attender dining</span></div><div class="v20-building parking"><b>Parking P1 / P2</b><span>Visitor · staff parking</span></div><div class="v20-building lift"><b>Service Lift</b><span>B1 / -1 → Floor 6</span></div><div class="v20-map-label entry">ENTRY · WAYFINDING START</div><div class="v20-map-label exit">EXIT · WAYFINDING END</div>${mapState.showHeat?'<div class="v20-heat h1"></div><div class="v20-heat h2"></div><div class="v20-heat h3"></div>':''}${mapState.showDept?mapDepartments():''}<svg class="v20-route-svg" viewBox="0 0 100 100" preserveAspectRatio="none"><polyline class="v20-route-base" points="${path}"/><polyline class="v20-route-glow" points="${path}"/><polyline class="v20-route-main" points="${path}"/><polyline class="v20-route-pulse" points="${path}"/></svg>${mapState.showRoutes?'<div class="v20-destination" style="left:'+s.dx+'%;top:'+s.dy+'%"><span>⌖</span></div>':''}${staffHtml}</div><div style="position:absolute;left:12px;bottom:12px;z-index:30;padding:7px 9px;border-radius:999px;background:rgba(6,16,30,.82);border:1px solid rgba(255,255,255,.12);font-size:7px;color:#9fc1dc">Selected route: <b style="color:#fff">${esc(s.name)}</b> → ${esc(destLabel)}</div></div>
        <aside class="v20-map-side"><div class="v20-side-section"><div class="v20-side-kicker">STAFF DIRECTORY</div><div class="v20-side-title">${vis.length} shown · click to focus</div><div class="v20-staff-list" id="v20StaffList">${rows||'<div style="padding:12px;color:#7897b6;font-size:8px">No staff match this filter.</div>'}</div></div><div class="v20-detail-card"><b>${esc(s.name)}</b><div class="v20-detail-grid"><div class="v20-detail-item"><span>Status</span><strong>${esc(s.status)}</strong></div><div class="v20-detail-item"><span>Wing</span><strong>${esc(s.wing)}</strong></div><div class="v20-detail-item"><span>Floor</span><strong>${s.floor===-1?'B1 / -1':s.floor}</strong></div><div class="v20-detail-item"><span>Ward</span><strong>${esc(s.ward)}</strong></div><div class="v20-detail-item"><span>Room</span><strong>${esc(s.room)}</strong></div><div class="v20-detail-item"><span>Next</span><strong>${esc(selectedDest)}</strong></div></div><div class="v20-side-controls"><button data-v20="focusSelected">⌖ Focus staff</button><button data-v20="follow">◉ Follow</button></div></div><div class="v20-route-panel"><h4>Route intelligence</h4><p>White-line route core with neon guidance shows the selected staff path from current position through the hospital network to the next handoff.</p><div class="v20-route-metrics"><div class="v20-route-metric"><b>${metrics.meters}</b><span>meters</span></div><div class="v20-route-metric"><b>${metrics.steps}</b><span>steps</span></div><div class="v20-route-metric"><b>${metrics.eta}</b><span>ETA</span></div></div><div class="v20-legend"><span><i style="background:#22a9ff"></i>Delivering</span><span><i style="background:#9c7aff"></i>Returning</span><span><i style="background:#f1ad31"></i>Waiting</span><span><i style="background:#2ad19a"></i>Patient room</span><span><i style="background:#fff"></i>Route core</span></div></div></aside></div><div class="v20-map-foot"><span><b>Map note:</b> Prototype indoor positions for sponsor demonstration; connect approved hospital location data for production use.</span><span>Indoor levels <b>B1 / -1 → 6</b></span></div></section>`;
  }
  function renderV20Map(){
    const host=document.getElementById('managerHome');if(!host||session.role!=='manager'||session.section!=='map')return;
    host.innerHTML=`<div class="section">LIVE STAFF MOVEMENT MAP</div>${managerMap()}`;
    const status=document.getElementById('v20MapStatus');if(status)status.value=mapState.status;
    const floor=document.getElementById('v20MapFloor');if(floor)floor.value=mapState.floor==='All'?'All':String(mapState.floor);
    const search=document.getElementById('v20MapSearch');
    if(search){search.oninput=()=>{const q=search.value.toLowerCase();document.querySelectorAll('#v20StaffList .v20-staff-row').forEach(r=>{r.style.display=r.textContent.toLowerCase().includes(q)?'grid':'none'});document.querySelectorAll('#v20MapStage .v20-staff').forEach(r=>{r.style.display=r.title.toLowerCase().includes(q)?'grid':'none'})}}
    const stage=document.getElementById('v20MapStage'); if(stage && !stage.dataset.dragBound){stage.dataset.dragBound='1'; let down=false,sx=0,sy=0,px=0,py=0; stage.addEventListener('pointerdown',ev=>{if(ev.target.closest('button,input,select'))return;down=true;sx=ev.clientX;sy=ev.clientY;px=mapState.panX||0;py=mapState.panY||0;stage.classList.add('dragging');}); stage.addEventListener('pointermove',ev=>{if(!down)return; const sc=document.getElementById('v20Scene'); if(sc){sc.style.transform=`translate(${px+(ev.clientX-sx)/3}px,${py+(ev.clientY-sy)/3}px) scale(${mapState.zoom})`;}}); const stop=()=>{if(!down)return;down=false;stage.classList.remove('dragging');}; stage.addEventListener('pointerup',stop); stage.addEventListener('pointerleave',stop);} 
  }
  window.v16RenderManagerMap=renderV20Map;
  window.v20RenderManagerMap=renderV20Map;
  function onMapClick(e){
    const btn=e.target.closest('[data-v20]');if(!btn)return;
    const a=btn.dataset.v20;
    if(a==='staff'){const t=team.find(x=>x.id===btn.dataset.id);if(t){mapState.selected=t.name;renderV20Map()}}
    else if(a==='toggleDept'){mapState.showDept=!mapState.showDept;renderV20Map()}
    else if(a==='toggleRoutes'){mapState.showRoutes=!mapState.showRoutes;renderV20Map()}
    else if(a==='toggleHeat'){mapState.showHeat=!mapState.showHeat;renderV20Map()}
    else if(a==='toggle3d'){mapState.show3d=!mapState.show3d;renderV20Map()}
    else if(a==='zoomIn'){mapState.zoom=Math.min(1.45,+((mapState.zoom||1)+.1).toFixed(2));const sc=document.getElementById('v20Scene');if(sc)sc.style.transform=`scale(${mapState.zoom})`}
    else if(a==='zoomOut'){mapState.zoom=Math.max(.86,+((mapState.zoom||1)-.1).toFixed(2));const sc=document.getElementById('v20Scene');if(sc)sc.style.transform=`scale(${mapState.zoom})`}
    else if(a==='center'){mapState.zoom=1;renderV20Map()}
    else if(a==='reset'){mapState={selected:'Suresh Kumar',status:'All',floor:'All',showDept:true,showRoutes:true,showHeat:true,show3d:true,zoom:1,destId:'staff'};renderV20Map()}
