    if(!fromOverlay)window.openVoiceQuantumMenu();
    const state=document.getElementById('voiceState'),card=document.getElementById('voiceOrderCard'),transcript=document.getElementById('voiceTranscript');
    const Speech=window.SpeechRecognition||window.webkitSpeechRecognition;
    if(!Speech){
      if(state){state.textContent='Voice input is not available in this browser. Use the visible menu below.';state.className='voice-state warn'}
      updateQvmStatus('Voice input is unavailable in this browser — choose a food from the visible quick menu.', 'warn');
