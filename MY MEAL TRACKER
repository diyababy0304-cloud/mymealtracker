function escapeHtml(s){return String(s).replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\'':'&#39;','"':'&quot;'}[c]));}
function switchLogin(role){
  document.querySelectorAll('.role-tab').forEach(b=>{const on=b.dataset.role===role;b.classList.toggle('active',on);b.setAttribute('aria-selected',on?'true':'false');});
  document.getElementById('patientLogin').style.display=role==='patient'?'block':'none';
  document.getElementById('attenderLogin').style.display=role==='attender'?'block':'none';
  document.getElementById('managerLogin').style.display=role==='manager'?'block':'none';
  document.getElementById('loginError').textContent='';
}
