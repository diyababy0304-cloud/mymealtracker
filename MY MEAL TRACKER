function complaintCard(){
  const d=complaintDraft; const isComplaint=d.type==='complaint'; const recording=!!(complaintRecorder&&complaintRecorder.state==='recording');
  return `<section class="card" id="complaintCard">
    <div class="headrow"><div><h3>Share a complaint or appreciation</h3><div class="mini">Add a note, attach a photo, or record a short voice message — it goes straight to the manager's Complaints list.</div></div><span class="pill ${isComplaint?'amber':'blue'}">${isComplaint?'⚠️ Complaint':'💙 Appreciation'}</span></div>
    <div style="display:flex;gap:8px;margin-top:13px;flex-wrap:wrap">
      <button class="secondary ${isComplaint?'active-toggle':''}" onclick="setComplaintType('complaint')">⚠️ Complaint</button>
      <button class="secondary ${!isComplaint?'active-toggle':''}" onclick="setComplaintType('appreciation')">💙 Appreciation</button>
    </div>
    <textarea id="complaintText" placeholder="${isComplaint?'Tell us what went wrong…':'Tell us what you loved…'}" style="width:100%;margin-top:12px;min-height:78px;border:1px solid #d7e6f2;border-radius:14px;padding:10px 12px;font:inherit;resize:vertical;color:#173b59">${escapeHtml(d.__lastText||'')}</textarea>
    <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:10px">
      <label class="secondary" style="cursor:pointer;display:inline-flex;align-items:center;gap:6px">📷 Attach photo<input type="file" accept="image/*" style="display:none" onchange="handleComplaintPhoto(event)"></label>
      <button class="secondary ${recording?'recording-btn':''}" id="complaintRecordBtn" onclick="toggleComplaintRecording()">🎙️ ${recording?'Stop recording':'Record voice note'}</button>
    </div>
    ${d.photo?`<div class="complaint-attach"><img src="${d.photo}" alt="Attached photo"><button class="icon-btn" onclick="removeComplaintPhoto()">✕ Remove photo</button></div>`:''}
    ${d.voice?`<div class="complaint-attach"><audio controls src="${d.voice}"></audio><button class="icon-btn" onclick="removeComplaintVoice()">✕ Remove voice note (${d.voiceDuration||0}s)</button></div>`:''}
    <div style="margin-top:14px"><button class="primary" onclick="submitComplaint()">Submit ${isComplaint?'complaint':'appreciation'}</button></div>
  </section>`;
}
function refreshComplaintCard(){
  const ta=document.getElementById('complaintText'); if(ta) complaintDraft.__lastText=ta.value;
  const host=document.getElementById('complaintCardHost'); if(host) host.innerHTML=complaintCard();
}
function setComplaintType(t){const ta=document.getElementById('complaintText'); if(ta)complaintDraft.__lastText=ta.value; complaintDraft.type=t; refreshComplaintCard();}
function handleComplaintPhoto(e){
  const file=e.target.files&&e.target.files[0]; if(!file)return;
  if(!file.type||!file.type.startsWith('image/')){toast('Please choose an image file');return;}
  const reader=new FileReader();
  reader.onload=()=>{complaintDraft.photo=reader.result;complaintDraft.photoName=file.name;refreshComplaintCard();toast('Photo attached');};
  reader.onerror=()=>toast('Could not read that photo, please try again');
  reader.readAsDataURL(file);
}
function removeComplaintPhoto(){complaintDraft.photo=null;complaintDraft.photoName=null;refreshComplaintCard();}
async function toggleComplaintRecording(){
  if(complaintRecorder&&complaintRecorder.state==='recording'){complaintRecorder.stop();return;}
  if(!navigator.mediaDevices||!navigator.mediaDevices.getUserMedia){toast('Voice recording is not supported in this browser');return;}
  try{
    complaintStream=await navigator.mediaDevices.getUserMedia({audio:true});
    complaintChunks=[];
    const opts=(window.MediaRecorder&&MediaRecorder.isTypeSupported&&MediaRecorder.isTypeSupported('audio/webm'))?{mimeType:'audio/webm'}:{};
    complaintRecorder=new MediaRecorder(complaintStream,opts);
    complaintRecorder.ondataavailable=ev=>{if(ev.data&&ev.data.size)complaintChunks.push(ev.data)};
    complaintRecorder.onstop=()=>{
      const blob=new Blob(complaintChunks,{type:(complaintRecorder&&complaintRecorder.mimeType)||'audio/webm'});
      const reader=new FileReader();
      reader.onload=()=>{complaintDraft.voice=reader.result;complaintDraft.voiceDuration=Math.max(1,Math.round((Date.now()-complaintRecordStart)/1000));refreshComplaintCard();toast('Voice note recorded');};
      reader.readAsDataURL(blob);
      if(complaintStream){complaintStream.getTracks().forEach(t=>t.stop());complaintStream=null;}
      clearInterval(complaintRecordTimer);
    };
    complaintRecorder.start();
    complaintRecordStart=Date.now();
    clearInterval(complaintRecordTimer);
    complaintRecordTimer=setInterval(()=>{const btn=document.getElementById('complaintRecordBtn');if(btn)btn.textContent=`⏹ Stop · ${Math.round((Date.now()-complaintRecordStart)/1000)}s`;},250);
    refreshComplaintCard();
    toast('Recording… tap again to stop');
  }catch(err){toast('Microphone permission is needed to record a voice note');}
}
function removeComplaintVoice(){complaintDraft.voice=null;complaintDraft.voiceDuration=0;refreshComplaintCard();}
function submitComplaint(){
  const textEl=document.getElementById('complaintText');
  const text=(textEl?textEl.value:'').trim();
  if(!text&&!complaintDraft.photo&&!complaintDraft.voice){toast('Add a note, photo, or voice recording first');return;}
  const p=patients[session.patientKey]||patients[session.attenderKey]||{};
  const id='CM-'+(complaintSeq++);
  const item={id,type:complaintDraft.type,patient:p.name||'Patient',room:p.room||'-',text,photo:complaintDraft.photo,voice:complaintDraft.voice,voiceDuration:complaintDraft.voiceDuration,time:new Date().toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'}),status:'New'};
  complaints.unshift(item);
  complaintDraft={type:'complaint',photo:null,photoName:null,voice:null,voiceDuration:0,__lastText:''};
  refreshComplaintCard();
  toast(item.type==='complaint'?'Complaint submitted to the F&B / care team':'Thank you — your appreciation has been shared with the team');
}

