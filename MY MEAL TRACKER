    else if(a==='follow'){toast(`Following ${mapState.selected}`)}
    else if(a==='dept'){mapState.destId=btn.dataset.dest;renderV20Map();toast(`${btn.dataset.dest.toUpperCase()} route selected`)}
  }
  document.addEventListener('click',e=>{if(session.role==='manager'&&session.section==='map'&&e.target.closest('.v20-map-shell'))onMapClick(e)});
  document.addEventListener('change',e=>{if(e.target.id==='v20MapStatus'){mapState.status=e.target.value;renderV20Map()}if(e.target.id==='v20MapFloor'){mapState.floor=e.target.value==='B1 / -1'?-1:(e.target.value==='All'?'All':Number(e.target.value));renderV20Map()}});

  /* ---------- Manager nav + section ---------- */
  const baseManagerRender=renderManagerSection;
  window.renderManagerSection=function(){
    if(session.role==='manager'&&session.section==='voice'){ensureVoiceDemoOrders();setManagerPageTitle('Voice Orders','Orders captured from the patient voice ordering interface · live-style operational list');document.getElementById('managerHome').innerHTML=managerVoiceOrders();return;}
    if(session.role==='manager'&&session.section==='map'){setManagerPageTitle('Hospital Map','3D indoor operations map · staff movement, routes, floors and departments');renderV20Map();return;}
    return baseManagerRender.apply(this,arguments);
  };
  const baseRenderNav=renderNav;
  window.renderNav=function(){
    if(session.role==='manager'){
      const nav=document.getElementById('mainNav');if(!nav)return;
