        {stage:'placed',time:t(35)},{stage:'dietitian_approved',time:t(32)},{stage:'fnb_received',time:t(31)},
        {stage:'kitchen_queued',time:t(30)},{stage:'kitchen_cooking',time:t(29)},{stage:'food_ready',time:t(11)}]}
