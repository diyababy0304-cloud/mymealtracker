  const dietToPatient={
    'Diabetic Care':'priya','Cardiac Low-Sodium':'rajan','Renal-Friendly':'lakshmi','High-Protein Soft':'arjun','Liquid Diet':'meera','Pureed Soft Diet':'vivek','Vegetarian High-Protein':'ananya'
  };
  const escM = (v)=>typeof escapeHtml==='function'?escapeHtml(v):String(v).replace(/[&<>'"]/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[m]));
  function approvalFor(diet){const key=dietToPatient[diet], c=careTeam?.[key]; return c?.dietitian || {name:'Assigned Clinical Dietitian',version:'DEMO-1.0',approved:'Demo approval recorded'};}
  function mealCard(m){return `<div class="v21-meal-card"><div class="v21-meal-head"><div><h4>${escM(m[1])}</h4><small>${escM(m[0])} · ${m[2].length} foods</small></div><span class="pill blue">Diet cleared</span></div>${m[2].map(f=>`<div class="v21-item"><div><b>${escM(f[0])}</b><span>${escM(f[1])}</span></div><div class="v21-tags"><i class="k">${f[2]} kcal</i><i class="p">${f[3]} g P</i></div></div>`).join('')}</div>`}
