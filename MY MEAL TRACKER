<script id="patient-gmap-js">
const GMAP_SCALE_K=1.83, GMAP_SPEED=70;
let GMAP_STATE={curKey:'myroom',curX:0,curY:0,zoom:1,destId:null};
function gmapCategoryLabel(cls){const c=(cls||'').split(' ')[0];return {clinical:'Clinical',service:'Service',food:'Food & Dining',public:'Patient & Family',warn:'Emergency'}[c]||'Facility';}
function gmapCatColor(cat){return {clinical:'linear-gradient(145deg,#4285f4,#1a56c4)',service:'linear-gradient(145deg,#a142f4,#6a1fcf)',food:'linear-gradient(145deg,#fa903e,#d9690e)',public:'linear-gradient(145deg,#5f6368,#3c4043)',warn:'linear-gradient(145deg,#ea4335,#b0271b)'}[cat]||'#5f6368';}
function gmapDist(points){let len=0;for(let i=1;i<points.length;i++){const x1=points[i-1][0],y1=points[i-1][1],x2=points[i][0],y2=points[i][1];len+=Math.hypot(x2-x1,y2-y1);}const meters=Math.round(len*GMAP_SCALE_K);const steps=Math.round(meters/0.75);const etaMin=meters/GMAP_SPEED;const mm=Math.floor(etaMin),ss=Math.round((etaMin-mm)*60);return {meters,steps,eta:`${mm}:${String(ss).padStart(2,'0')}`};}
function gmapPath(curPt,destPt,destId){const lobby=[21,66],emg=[10,60];const near=(a,b)=>Math.abs(a[0]-b[0])<2.5&&Math.abs(a[1]-b[1])<2.5;let pts=[curPt];if((destId==='emergency'||destId==='icu')&&!near(curPt,emg))pts.push(emg);else if(!near(curPt,lobby)&&!near(destPt,lobby))pts.push(lobby);if(!near(pts[pts.length-1],destPt))pts.push(destPt);return pts;}
function gmapSmoothPath(points){if(points.length<2)return '';if(points.length===2)return `M ${points[0][0]} ${points[0][1]} L ${points[1][0]} ${points[1][1]}`;let d=`M ${points[0][0]} ${points[0][1]} `;for(let i=0;i<points.length-1;i++){const p0=points[i],p1=points[i+1],midX=(p0[0]+p1[0])/2,midY=(p0[1]+p1[1])/2;d+=`Q ${p0[0]} ${p0[1]} ${midX} ${midY} `;}const last=points[points.length-1];d+=`L ${last[0]} ${last[1]}`;return d;}

function renderPatientGMap(depts,iconFor,room,safeFloor){
  const roomDept=depts.find(d=>d.id==='patient')||{x:75,y:73,name:room};
  const CUR_PRESETS=[
    {key:'myroom',label:'My Room',icon:'🛏️',x:roomDept.x,y:roomDept.y},
    {key:'entry',label:'Main Entry',icon:'🚪',x:8,y:79},
    {key:'lobby',label:'Main Lobby',icon:'🏛️',x:21,y:66},
    {key:'opdwait',label:'OPD Waiting',icon:'🪑',x:67,y:31},
    {key:'emergency',label:'Emergency',icon:'🚑',x:10,y:43},
  ];
  const destList=depts.filter(d=>d.id!=='parking');
  const defaultDestId=depts.some(d=>d.id==='opd')?'opd':destList[0].id;
  const defaultDest=depts.find(d=>d.id===defaultDestId)||destList[0];
  const initPath=gmapPath([roomDept.x,roomDept.y],[defaultDest.x,defaultDest.y],defaultDestId);
  const initD=gmapSmoothPath(initPath);
  const initInfo=gmapDist(initPath);
  const catChips=[['all','All'],['clinical','Clinical'],['service','Service'],['food','Food'],['public','Family'],['warn','Emergency']];
  const pins=destList.map(d=>{
    const cat=(d.cls||'').split(' ')[0];
    const sel=d.id===defaultDestId?' selected':'';
    return `<div class="gmap-poi ${cat}${sel}" data-id="${d.id}" data-x="${d.x}" data-y="${d.y}" data-cat="${cat}" style="left:${d.x}%;top:${d.y}%" onclick="gmapSelectDest('${d.id}')"><div class="gmap-pin"><span>${escapeHtml(iconFor(d.id))}</span></div><div class="gmap-poi-label">${escapeHtml(d.name)}</div></div>`;
  }).join('');
  const listRows=destList.map(d=>{
    const cat=(d.cls||'').split(' ')[0];
    const act=d.id===defaultDestId?' active':'';
    return `<div class="gmap-row${act}" data-id="${d.id}" data-cat="${cat}" data-name="${escapeHtml(d.name.toLowerCase())}" onclick="gmapSelectDest('${d.id}')"><div class="ric" style="background:${gmapCatColor(cat)}">${escapeHtml(iconFor(d.id))}</div><div class="rtxt"><b>${escapeHtml(d.name)}</b><span>${escapeHtml(d.sub)} · ${gmapCategoryLabel(d.cls)}</span></div><div class="rarrow">›</div></div>`;
  }).join('');
  const curChips=CUR_PRESETS.map((c,i)=>`<button class="gmap-cbtn${i===0?' active':''}" data-key="${c.key}" data-x="${c.x}" data-y="${c.y}" onclick="gmapSetCurrent(this)"><span>${c.icon}</span>${escapeHtml(c.label)}</button>`).join('');
  const chips=catChips.map(([k,l],i)=>`<button class="gmap-chip${i===0?' active':''}" data-cat="${k}" onclick="gmapFilterCat('${k}',this)">${l}</button>`).join('');
  return `<section class="gmap-wrap" id="gmapShell" data-room="${escapeHtml(room)}" data-roomx="${roomDept.x}" data-roomy="${roomDept.y}" data-default-dest="${defaultDestId}">
    <div class="gmap-top">
      <div class="gmap-title-row"><div><div class="gmap-title">🗺️ Hospital Navigator</div><div class="gmap-sub">A clear, Google Maps-style wayfinding view — pick where you are and where you need to go, with ${destList.length}+ departments mapped across the campus.</div></div><span class="gmap-live"><i></i>LIVE</span></div>
      <div class="gmap-search"><span class="gico">🔍</span><input id="gmapSearchBox" placeholder="Search a department, ward or facility…" oninput="gmapSearchDept(this.value)"></div>
      <div class="gmap-current" id="gmapCurrentChips">${curChips}</div>
    </div>
    <div class="gmap-chips" id="gmapCatChips">${chips}</div>
    <div class="gmap-stage" id="gmapStage">
      <div class="gmap-compass">N</div>
      <div class="gmap-canvas" id="gmapCanvas">
        <div class="gmap-road r1"></div><div class="gmap-road r2"></div><div class="gmap-road r3"></div><div class="gmap-road r4"></div>
        ${pins}
        <div class="gmap-me" id="gmapMe" style="left:${roomDept.x}%;top:${roomDept.y}%"><div class="ring"></div><div class="core"></div><div class="gmap-me-label">You are here</div></div>
        <svg class="gmap-svg" viewBox="0 0 100 100" preserveAspectRatio="none"><path id="gmapRouteShadow" class="gmap-route-shadow" d="${initD}"/><path id="gmapRouteLine" class="gmap-route-line" d="${initD}"/></svg>
        <div class="gmap-walker" id="gmapWalker"><div class="wdot">🚶</div></div>
      </div>
      <div class="gmap-zoom"><button onclick="gmapZoom(1)">＋</button><button onclick="gmapZoom(-1)">－</button></div>
      <button class="gmap-recenter" onclick="gmapRecenter()">⌖</button>
      <div class="gmap-infobar" id="gmapInfobar">
        <div class="go">➤</div>
        <div class="txt"><b id="gmapDestName">To ${escapeHtml(defaultDest.name)}</b><span id="gmapDestSub">${escapeHtml(defaultDest.sub)} · ${gmapCategoryLabel(defaultDest.cls)}</span></div>
        <div class="stats"><div class="stat"><b id="gmapDistVal">${initInfo.meters}m</b><small>Meters</small></div><div class="stat"><b id="gmapStepsVal">${initInfo.steps}</b><small>Steps</small></div><div class="stat"><b id="gmapEtaVal">${initInfo.eta}</b><small>ETA</small></div></div>
      </div>
    </div>
    <div class="gmap-list-wrap">
      <div class="gmap-list-head"><b>Facilities &amp; Departments</b><span id="gmapListCount">${destList.length} places</span></div>
      <div class="gmap-list" id="gmapList">${listRows}</div>
    </div>
  </section>`;
}
function gmapSetCurrent(btn){
  document.querySelectorAll('#gmapCurrentChips .gmap-cbtn').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');
  const x=parseFloat(btn.dataset.x),y=parseFloat(btn.dataset.y);
  GMAP_STATE.curX=x;GMAP_STATE.curY=y;GMAP_STATE.curKey=btn.dataset.key;
  const me=document.getElementById('gmapMe');
  if(me){me.style.left=x+'%';me.style.top=y+'%';}
  toast(btn.textContent.trim()+' set as your current location');
  if(GMAP_STATE.destId)gmapSelectDest(GMAP_STATE.destId);
}
function gmapSelectDest(id){
  const shell=document.getElementById('gmapShell');if(!shell)return;
  if(!GMAP_STATE.curX&&!GMAP_STATE.curY){const rx=parseFloat(shell.dataset.roomx),ry=parseFloat(shell.dataset.roomy);GMAP_STATE.curX=rx;GMAP_STATE.curY=ry;}
  const poi=shell.querySelector(`.gmap-poi[data-id="${id}"]`);if(!poi)return;
  const destX=parseFloat(poi.dataset.x),destY=parseFloat(poi.dataset.y);
  shell.querySelectorAll('.gmap-poi.selected').forEach(p=>p.classList.remove('selected'));
  poi.classList.add('selected');
  shell.querySelectorAll('.gmap-row.active').forEach(r=>r.classList.remove('active'));
  const row=shell.querySelector(`.gmap-row[data-id="${id}"]`);if(row){row.classList.add('active');row.scrollIntoView({block:'nearest'});}
  GMAP_STATE.destId=id;
  const pathPts=gmapPath([GMAP_STATE.curX,GMAP_STATE.curY],[destX,destY],id);
  const dPath=gmapSmoothPath(pathPts);
  const shadow=shell.querySelector('#gmapRouteShadow'),line=shell.querySelector('#gmapRouteLine');
  if(shadow)shadow.setAttribute('d',dPath);
  if(line)line.setAttribute('d',dPath);
  const info=gmapDist(pathPts);
  const destName=poi.querySelector('.gmap-poi-label').textContent;
  const destSub=row?row.querySelector('.rtxt span').textContent:'';
  const dn=document.getElementById('gmapDestName');if(dn)dn.textContent='To '+destName;
  const ds=document.getElementById('gmapDestSub');if(ds)ds.textContent=destSub;
  const dv=document.getElementById('gmapDistVal');if(dv)dv.textContent=info.meters+'m';
  const sv=document.getElementById('gmapStepsVal');if(sv)sv.textContent=info.steps;
  const ev=document.getElementById('gmapEtaVal');if(ev)ev.textContent=info.eta;
  gmapAnimateWalker(pathPts);
  toast('Route drawn to '+destName+' · '+info.meters+'m · ETA '+info.eta);
}
let __gmapRaf=null;
function gmapAnimateWalker(points){
  const walker=document.getElementById('gmapWalker');if(!walker)return;
  if(__gmapRaf)cancelAnimationFrame(__gmapRaf);
  const duration=2600,segCount=points.length-1;let t0=null;
  function frame(ts){
    if(!t0)t0=ts;
    const f=((ts-t0)%duration)/duration,scaled=f*segCount;
    const i=Math.min(Math.floor(scaled),segCount-1),p=scaled-i;
    const a=points[i],b=points[i+1];
    const x=a[0]+(b[0]-a[0])*p,y=a[1]+(b[1]-a[1])*p;
    walker.style.left=x+'%';walker.style.top=y+'%';
    __gmapRaf=requestAnimationFrame(frame);
  }
  __gmapRaf=requestAnimationFrame(frame);
}
function gmapFilterCat(cat,btn){
  document.querySelectorAll('#gmapCatChips .gmap-chip').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');
  gmapSearchDept(document.getElementById('gmapSearchBox')?document.getElementById('gmapSearchBox').value:'');
}
function gmapSearchDept(q){
  q=(q||'').toLowerCase().trim();
  const activeCat=document.querySelector('#gmapCatChips .gmap-chip.active')?.dataset.cat||'all';
  let count=0;
  document.querySelectorAll('.gmap-row').forEach(r=>{
    const match=!q||r.dataset.name.includes(q);
    const catOk=activeCat==='all'||r.dataset.cat===activeCat;
    const show=match&&catOk;
    r.style.display=show?'':'none';
    if(show)count++;
  });
  document.querySelectorAll('.gmap-poi').forEach(p=>{
    const name=(p.querySelector('.gmap-poi-label')?.textContent||'').toLowerCase();
    const match=!q||name.includes(q);
    const catOk=activeCat==='all'||p.dataset.cat===activeCat;
    p.style.display=(match&&catOk)?'':'none';
  });
  const c=document.getElementById('gmapListCount');if(c)c.textContent=count+' places';
}
function gmapZoom(delta){
  GMAP_STATE.zoom=Math.min(1.6,Math.max(0.75,(GMAP_STATE.zoom||1)+delta*0.15));
  const canvas=document.getElementById('gmapCanvas');
  if(canvas)canvas.style.transform=`scale(${GMAP_STATE.zoom})`;
}
function gmapRecenter(){
  GMAP_STATE.zoom=1;
  const canvas=document.getElementById('gmapCanvas');
  if(canvas)canvas.style.transform='scale(1)';
  toast('Map recentred');
}
setInterval(()=>{
  const shell=document.getElementById('gmapShell');
  if(shell&&shell.dataset.inited!=='1'){
    shell.dataset.inited='1';
    const rx=parseFloat(shell.dataset.roomx),ry=parseFloat(shell.dataset.roomy);
    GMAP_STATE={curKey:'myroom',curX:rx,curY:ry,zoom:1,destId:shell.dataset.defaultDest};
    const dd=shell.dataset.defaultDest;
    const poi=shell.querySelector(`.gmap-poi[data-id="${dd}"]`);
    if(poi){
      const destX=parseFloat(poi.dataset.x),destY=parseFloat(poi.dataset.y);
      const pathPts=gmapPath([rx,ry],[destX,destY],dd);
      gmapAnimateWalker(pathPts);
    }
  }
},400);
</script>
