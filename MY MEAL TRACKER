      <div class="v21-approved"><div><b>✓ Approved diet plan</b><span>${escM(c.name)} · ${escM(c.version)} · ${escM(c.approved)}</span></div><span class="pill">Ready for manager review</span></div></div>
      <div class="v21-menu-toolbar"><span class="pill">${d.length} meal windows</span><span class="pill">${d.reduce((n,m)=>n+m[2].length,0)} scheduled foods</span><span class="pill">${ind.length} individual foods</span><span class="pill">${bev.length} beverages</span><button class="secondary" onclick="toast('Showing ${escM(selected)} in manager menu')">✓ ${escM(selected)}</button></div>
