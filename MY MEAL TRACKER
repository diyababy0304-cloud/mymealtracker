  function setInlineMenuHost(p){const host=document.getElementById('patientOverview');if(!host)return;host.innerHTML=`${patientProfileCard(p)}<div class="section">MENU PLANNING</div>${patientWorkspace(p,session.menuMode||'meals')}`;}
  window.v22SelectInlinePlan=function(code){session.__mealPlan=code;setInlineMenuHost(fallbackPatient());toast(`Plan ${code} opened inside Menu Planning`)};
