      nav.innerHTML=items.map(([k,l])=>`<button class="${session.section===k?'active':''}" onclick="showSection('${k}')">${l}</button>`).join('');
      return;
    }
    return baseRenderNav.apply(this,arguments);
  };

  /* Nano-style menu opening: keep the real existing menu logic but add a visual layer */
  const baseOpenMenu=window.openMenuPlanner;
  window.openMenuPlanner=function(){baseOpenMenu.apply(this,arguments);setTimeout(()=>{
    const drawer=document.querySelector('#menuBackdrop .drawer');if(!drawer)return;
    if(!drawer.querySelector('.v20-menu-tech')){
      const tech=document.createElement('div');tech.className='v20-menu-tech';tech.innerHTML='<div class="v20-menu-orb">✦</div><div><b>NANO FLOW MENU</b><span>Tap a meal to reveal exact food, nutrition & timing</span></div><div class="v20-signal"><i></i>READY</div>';
      const filters=drawer.querySelector('.filters');if(filters)filters.after(tech);else drawer.querySelector('.drawer-head')?.after(tech);
    }
    drawer.classList.add('nano-open');
  },35)};
})();
