function notice(text,ring){const n=document.getElementById('dpNotice');if(!n)return;n.textContent=text;n.classList.add('show');if(ring)beep();setTimeout(()=>n.classList.remove('show'),6500)}
function enableSound(){try{audioContext=audioContext||new(window.AudioContext||window.webkitAudioContext)();audioContext.resume();audioOn=true;const b=document.getElementById('dpSoundButton');if(b)b.textContent='🔔 Sound on';notice('Sound alerts are on. New delivery allocations will ring here.',false);checkNextOrder()}catch(e){notice('Sound is unavailable in this browser. Keep this portal open to see new orders.',false)}}
function checkNextOrder(){if(!currentStaff||!online)return;const o=staffJobs(currentStaff.id).find(x=>(x.deliveryState||'assigned')==='assigned'&&!alerted.has(x.id));if(o){alerted.add(o.id);notice('🔔 Next order for you: '+o.id+' · '+(o.meal||'Meal order')+'. Press OK to accept.',true)}}
function teamHtml(){return roster.map(r=>`<div class="dp-team-row"><div class="dp-avatar">${r.icon}</div><div><b>${esc(r.name)}</b><small>${r.id} · F&amp;B delivery</small></div><span class="dp-team-count">${staffJobs(r.id).length} orders</span></div>`).join('')}
function orderHtml(o){const n=stage(o),pat=Object.values(patients||{}).find(p=>p.name===o.patient),destination=pat?`Room ${pat.room} · Floor ${pat.floor}`:'Patient room';let action='';if(n===0)action=`<button class="dp-btn gold" onclick="deliveryAction('${esc(o.id)}','accept')">✓ OK · Accept order</button>`;else if(n===1)action=`<button class="dp-btn" onclick="deliveryAction('${esc(o.id)}','kitchen')">📍 I’m at the kitchen</button>`;else if(n===2)action=`<button class="dp-btn gold" onclick="deliveryAction('${esc(o.id)}','pickup')">🥡 Food ready · Pick up</button>`;else if(n===3)action=`<button class="dp-btn gold" onclick="deliveryAction('${esc(o.id)}','start')">▶ Start delivery · Go online</button>`;else if(n===4)action=`<button class="dp-btn" onclick="deliveryAction('${esc(o.id)}','delivered')">✓ Confirm bedside delivery</button>`;return `<article class="dp-order"><div class="dp-order-head"><div><h3>${esc(o.id)} · ${esc(o.meal||'Meal order')}</h3><p>${esc(o.patient||'Patient')} · ${esc(destination)} · ${esc(o.diet||'Diet plan')}</p></div><span class="dp-status ${n===2?'ready':n===5?'done':''}">${stageLabel(o)}</span></div><div class="dp-route ${n>=4?'on-route':''}" aria-label="Kitchen to patient delivery progress"><span class="dp-stop kitchen"><i>🍽️</i>Kitchen</span><span class="dp-stop patient"><i>🛏️</i>Patient</span><span class="dp-trolley">🛒</span></div><div class="dp-actions">${action}${o.deliveryDemo?'<span class="dp-status">Demo delivery traffic</span>':''}</div></article>`}
function renderStaff(){const app=document.getElementById('app'),root=document.getElementById('deliveryPortal');if(!app||!root||!currentStaff)return;document.body.classList.add('delivery-mode');app.classList.add('delivery-mode');app.style.display='block';root.style.display='block';const all=allJobs().filter(o=>o.deliveryStaff===currentStaff.id),open=all.filter(o=>o.status!=='Delivered'),waiting=open.filter(o=>stage(o)<4),runs=open.filter(o=>stage(o)===4),done=all.filter(o=>o.status==='Delivered');const now=online?'🟢 Online':'⚪ Offline';root.innerHTML=`<header class="dp-top"><div class="dp-brand"><div class="dp-emblem">🥘</div><div><h1>Delivery Partner Portal</h1><p>Meal service · kitchen to bedside</p></div></div><div class="dp-header-actions"><span class="dp-pill">${esc(currentStaff.name)} · ${currentStaff.id}</span><span class="dp-pill">${now}</span><button id="dpSoundButton" class="dp-btn ghost" onclick="deliveryEnableSound()">🔔 Enable sound</button><button class="dp-btn ghost" onclick="deliveryResetDemo()">↻ Reset demo shift</button><button class="dp-btn ghost" onclick="downloadApp(event)">⬇ Download app</button><button class="dp-btn ghost" onclick="deliveryLogout()">Sign out</button></div></header><div class="dp-content"><div id="dpNotice" class="dp-notice" role="status" aria-live="polite"></div><div class="dp-kicker">Your shift at a glance</div><section class="dp-stats"><div class="dp-stat"><span>Open orders</span><b>${open.length}</b></div><div class="dp-stat"><span>Waiting / kitchen</span><b>${waiting.length}</b></div><div class="dp-stat"><span>On the way</span><b>${runs.length}</b></div><div class="dp-stat"><span>Delivered today</span><b>${done.length}</b></div></section><div class="dp-grid"><section class="dp-panel"><h2>My delivery queue</h2><p class="dp-sub">Acknowledge each allocation, wait at the kitchen, confirm pickup, then start the patient-visible trip.</p>${open.length?open.map(orderHtml).join(''):'<p class="dp-sub">Your queue is clear. Keep your status online for the next assignment.</p>'}<div class="dp-actions"><button class="dp-btn ${online?'gold':''}" onclick="deliveryToggleOnline()">${online?'● Go offline':'● Go online for new orders'}</button></div></section><div><section class="dp-panel"><h2>Kitchen staging point</h2><p class="dp-sub">Stay near the food-service desk until the kitchen marks your tray ready.</p><div class="dp-map"><div class="dp-building"></div><div class="dp-corridor"></div><div class="dp-kitchen-pin">🍳 Kitchen</div><div class="dp-patient-pin">🛏️ Ward</div><div class="dp-map-cart">🛒</div></div><p class="dp-sub" style="margin:12px 0 0">Pickup flow: <b>Assigned → OK → At kitchen → Food ready → Go online</b></p></section></div></div></div>`;checkNextOrder()}
function action(id,act){const o=allJobs().find(x=>x.id===id&&x.deliveryStaff===currentStaff?.id);if(!o)return;if(act==='accept'){o.deliveryState='accepted';o.deliveryAcceptedAt=Date.now();notice('Order '+id+' accepted. Please stay by the kitchen pickup point.',false)}else if(act==='kitchen'){if(o.deliveryState!=='accepted')return;o.deliveryAtKitchen=true;o.deliveryState='at-kitchen';notice('You are marked at the kitchen. Wait here until the tray is ready.',false)}else if(act==='pickup'){if(!o.deliveryAtKitchen)return;o.deliveryPickedUp=true;o.deliveryState='picked-up';notice('Pickup confirmed for '+id+'. Start the delivery when you leave the kitchen.',false)}else if(act==='start'){if(!o.deliveryPickedUp)return;online=true;o.deliveryState='on-route';o.deliveryStartedAt=Date.now();o.status='Patient';notice('You are online and on the way. The patient can now follow this delivery.',false)}else if(act==='delivered'){o.deliveryState='delivered';o.status='Delivered';o.deliveryCompletedAt=Date.now();notice('Bedside delivery confirmed for '+id+'.',false);alerted.delete(id)}o.deliveryUpdated=Date.now();save();renderStaff();if(act==='delivered')setTimeout(checkNextOrder,350)}
function login(){const id=document.getElementById('deliveryEmployeeId')?.value;const r=roster.find(x=>x.id===id);if(!r){const e=document.getElementById('loginError');if(e)e.textContent='Choose your employee ID to continue.';return}currentStaff=r;online=false;alerted.clear();try{localStorage.setItem('apollo.meal.delivery.lastEmployee',r.id)}catch(e){};document.getElementById('signInPage').style.display='none';document.getElementById('app').style.display='block';const badge=document.getElementById('roleBadge');if(badge)badge.textContent='🛵 Delivery · '+r.name;renderStaff()}
function logout(){currentStaff=null;online=false;const app=document.getElementById('app'),root=document.getElementById('deliveryPortal');if(root)root.style.display='none';document.body.classList.remove('delivery-mode');if(app){app.classList.remove('delivery-mode');app.style.display='none'}document.getElementById('signInPage').style.display='grid';switchLogin('delivery')}
function toggleOnline(){online=!online;renderStaff();if(online){notice('You are online for new delivery allocations.',false);checkNextOrder()}}
function managerPanel(){const unassigned=allJobs().filter(o=>o.status!=='Delivered'&&!o.deliveryStaff);const team=roster.map(r=>{const count=staffJobs(r.id).length;return `<div class="dm-person"><span class="dm-avatar">${r.icon}</span><div><b>${esc(r.name)}</b><small>${r.id}</small></div><span class="dm-load">${count}/3</span></div>`}).join('');return `<section id="deliveryManagerPanel"><div class="dm-header"><div><h3>🛵 Delivery staff &amp; allocation</h3><p class="dm-copy">Assign a bedside delivery partner. Each person can carry up to three open orders.</p></div><span class="dm-badge">10 staff · live workload</span></div><div class="dm-roster">${team}</div><div class="dm-section-title"><span>Orders waiting for a delivery partner</span><span>${unassigned.length} unassigned</span></div>${unassigned.length?`<div class="dm-grid">${unassigned.map(o=>`<div class="dm-row"><div class="dm-order"><b>${esc(o.id)}</b><small>${esc(o.patient||'Patient')} · ${esc(o.meal||'Meal')}</small></div><select id="dm-${esc(o.id)}">${roster.map(r=>`<option value="${r.id}" ${staffJobs(r.id).length>=3?'disabled':''}>${esc(r.name)} · ${r.id} · ${staffJobs(r.id)}/3</option>`).join('')}</select><button onclick="deliveryAssign('${esc(o.id)}',document.getElementById('dm-${esc(o.id)}').value)">Assign</button></div>`).join('')}</div>`:'<div class="dm-empty">All current orders have a delivery partner. New orders will appear here.</div>'}</section>`}
function resetDemo(){allJobs().filter(o=>o.deliveryDemo).forEach(o=>{o.status='Kitchen';o.deliveryState='assigned';o.deliveryAtKitchen=false;o.deliveryPickedUp=false;delete o.deliveryAcceptedAt;delete o.deliveryStartedAt;delete o.deliveryCompletedAt;o.deliveryUpdated=Date.now()});online=false;alerted.clear();save();renderStaff();notice('Demo delivery queue reset: two new orders are ready for each staff member.',false)}
function assign(id,staffId){const o=allJobs().find(x=>x.id===id);if(!o)return;const r=roster.find(x=>x.id===staffId);if(!r)return;const count=staffJobs(staffId).filter(x=>x.id!==id).length;if(count>=3){if(window.toast)toast(r.name+' already has 3 open orders. Choose another delivery person.');return}o.deliveryStaff=staffId;o.deliveryState='assigned';o.deliveryAtKitchen=false;o.deliveryPickedUp=false;o.deliveryUpdated=Date.now();save();if(window.toast)toast(id+' allocated to '+r.name+' · '+r.id);if(typeof window.renderManagerSection==='function')window.renderManagerSection()}
function patientCard(p){mergeSaved();const matches=allJobs().filter(o=>o.patient===p.name&&o.deliveryStaff&&(o.deliveryDemo||o.deliveryState)&&o.status!=='Delivered').sort((a,b)=>(b.deliveryUpdated||0)-(a.deliveryUpdated||0));const completed=allJobs().filter(o=>o.patient===p.name&&o.deliveryState==='delivered').sort((a,b)=>(b.deliveryCompletedAt||0)-(a.deliveryCompletedAt||0))[0];const o=matches[0]||completed;if(!o)return '';const n=stage(o),names=['Order assigned','Staff accepted','At kitchen','Food picked up','On the way','Delivered'];const employee=roster.find(r=>r.id===o.deliveryStaff);const steps=['Allocation','Staff OK','Kitchen','Picked up','On route','Bedside'];const current=Math.min(Math.max(n,0),5);return `<section class="card dp-patient-card"><div class="dp-patient-head"><div><span class="dp-live-dot"></span><b>Delivery visibility</b></div><span class="dp-status">${names[n]}</span></div><p><b>${esc(o.meal||'Meal')} · ${esc(o.id)}</b> ${employee?'with '+esc(employee.name)+' · '+employee.id:'awaiting staff assignment'} ${o.deliveryDemo?'<span class="dp-status">Demo delivery</span>':''}</p><div class="dp-patient-track">${steps.map((x,i)=>`<div class="dp-patient-step ${i<=current?'complete':''}"><i>${i<current?'✓':i+1}</i><span>${x}</span></div>`).join('')}</div>${n===4?'<div class="dp-patient-route">🛒 Your delivery is moving from the kitchen toward your room.</div>':''}${n===5?'<div class="dp-patient-route done">✓ Your meal has arrived at your bedside.</div>':''}</section>`}
function refreshFromStorage(){mergeSaved();if(currentStaff)renderStaff();if(typeof session!=='undefined'&&session.role==='patient'&&window.renderPatientSection){const p=patients?.[session.patientKey];if(p)window.renderPatientSection(p)}}
function init(){seedDemoJobs();const tabs=document.querySelector('.role-tabs');if(tabs&&!tabs.querySelector('[data-role="delivery"]'))tabs.insertAdjacentHTML('beforeend','<button class="role-tab" role="tab" aria-selected="false" data-role="delivery" onclick="switchLogin(\'delivery\')">🛵 Delivery</button>');const form=document.querySelector('.auth-form');if(form&&!document.getElementById('deliveryLogin')){const block=document.createElement('div');block.id='deliveryLogin';block.style.display='none';block.innerHTML=`<p class="dp-sub">Sign in with your employee ID. Each profile has a separate delivery queue.</p><label for="deliveryEmployeeId">Employee ID · select your profile</label><select id="deliveryEmployeeId">${roster.map(r=>`<option value="${r.id}">${r.id} · ${r.name}</option>`).join('')}</select><div class="dp-roster-preview" aria-label="Delivery staff accounts">${roster.map(r=>`<button type="button" onclick="document.getElementById('deliveryEmployeeId').value='${r.id}'"><b>${r.id}</b><br>${esc(r.name)}</button>`).join('')}</div><button class="dp-login-button" type="button" onclick="deliveryLogin()">Open delivery staff portal →</button>`;form.appendChild(block)}if(!document.getElementById('deliveryPortal')){const root=document.createElement('div');root.id='deliveryPortal';root.setAttribute('aria-live','polite');const shell=document.getElementById('app');if(shell)shell.insertBefore(root,shell.firstChild);else document.body.appendChild(root)}const originalSwitch=window.switchLogin;if(originalSwitch&&!originalSwitch.__deliveryWrapped){const wrapped=function(role){if(role==='delivery'){document.querySelectorAll('.role-tab').forEach(b=>{const on=b.dataset.role==='delivery';b.classList.toggle('active',on);b.setAttribute('aria-selected',String(on))});['patientLogin','attenderLogin','managerLogin','dietitianLogin','fnbLogin','kitchenLogin'].forEach(id=>{const x=document.getElementById(id);if(x)x.style.display='none'});const d=document.getElementById('deliveryLogin');if(d)d.style.display='block';const e=document.getElementById('loginError');if(e)e.textContent='';return}const d=document.getElementById('deliveryLogin');if(d)d.style.display='none';originalSwitch(role)};wrapped.__deliveryWrapped=true;window.switchLogin=wrapped}
const oldManager=window.renderManagerSection;if(oldManager&&!oldManager.__deliveryWrapped){const wrapped=function(){oldManager.apply(this,arguments);if(session.role==='manager'&&session.section==='delivery'){const host=document.getElementById('managerHome');if(host&&!document.getElementById('deliveryManagerPanel'))host.insertAdjacentHTML('beforeend',managerPanel())}};wrapped.__deliveryWrapped=true;window.renderManagerSection=wrapped}
const oldPatient=window.renderPatientSection;if(oldPatient&&!oldPatient.__deliveryWrapped){const wrapped=function(p){oldPatient.apply(this,arguments);const host=document.getElementById('patientOverview');if(host){const card=patientCard(p);if(card)host.insertAdjacentHTML('beforeend',card)}};wrapped.__deliveryWrapped=true;window.renderPatientSection=wrapped}
window.deliveryLogin=login;window.deliveryLogout=logout;window.deliveryAction=action;window.deliveryEnableSound=enableSound;window.deliveryToggleOnline=toggleOnline;window.deliveryAssign=assign;window.deliveryResetDemo=resetDemo;
try{if('BroadcastChannel'in window){window.deliveryChannel=new BroadcastChannel('apollo-meal-delivery');window.deliveryChannel.onmessage=refreshFromStorage}}catch(e){}window.addEventListener('storage',e=>{if(e.key===KEY)refreshFromStorage()});mergeSaved();
}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init,{once:true});else init();
})();
</script><style id="white-meal-journey-v2">
