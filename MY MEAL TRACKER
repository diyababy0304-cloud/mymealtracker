<script id="menu-animation-v3-js">
(function(){
  function drawer(){return document.querySelector('#menuBackdrop .drawer')}
  function list(){return document.getElementById('menuList')}
  function animateMenu(reason){
    const l=list(), d=drawer();
    if(!l) return;
    l.classList.remove('menu-animating'); void l.offsetWidth; l.classList.add('menu-animating');
    const items=l.querySelectorAll('.meal,.individual-item,.beverage-card');
    items.forEach((el,i)=>{el.style.animationDelay=(.04+Math.min(i,10)*.055)+'s'; el.classList.remove('menu-reenter'); void el.offsetWidth; el.classList.add('menu-reenter');});
    if(d){
      const cls=reason==='filter'?'menu-filter-switch-v3':'menu-mode-switch-v3';
      d.classList.remove(cls); void d.offsetWidth; d.classList.add(cls);
      setTimeout(()=>d.classList.remove(cls),500);
    }
    setTimeout(()=>l.classList.remove('menu-animating'),1100);
  }
  function sparkFrom(el){
    if(!el||window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const r=el.getBoundingClientRect(), cx=r.left+r.width*.5, cy=r.top+r.height*.5;
    const count=5;
    for(let i=0;i<count;i++){
      const s=document.createElement('span'); s.className='menu-spark-v3';
      s.style.left=cx+'px'; s.style.top=cy+'px';
      const a=(Math.PI*2*i/count)+Math.random()*.45, dist=22+Math.random()*25;
      s.style.setProperty('--sx',(Math.cos(a)*dist).toFixed(1)+'px');
      s.style.setProperty('--sy',(Math.sin(a)*dist).toFixed(1)+'px');
      document.body.appendChild(s); setTimeout(()=>s.remove(),650);
    }
  }
  function bindMenu(){
    const mb=document.getElementById('menuBackdrop'); if(!mb||mb.dataset.menuV3) return;
    mb.dataset.menuV3='1';
    const originalOpen=window.openMenuPlanner;
    if(typeof originalOpen==='function'){
      window.openMenuPlanner=function(){
        originalOpen.apply(this,arguments);
        mb.classList.add('menu-active');
        setTimeout(()=>animateMenu('open'),45);
      };
    }
    const originalClose=window.closeMenuPlanner;
    if(typeof originalClose==='function'){
      window.closeMenuPlanner=function(){
        mb.classList.remove('menu-active');
        setTimeout(()=>originalClose.apply(this,arguments),80);
      };
    }
    const originalSet=window.setMenuMode;
    if(typeof originalSet==='function'){
      window.setMenuMode=function(mode){originalSet.apply(this,arguments);mb.classList.add('menu-active');setTimeout(()=>animateMenu('mode'),70)};
    }
    const originalFilter=window.filterMenu;
    if(typeof originalFilter==='function'){
      window.filterMenu=function(diet){originalFilter.apply(this,arguments);mb.classList.add('menu-active');setTimeout(()=>animateMenu('filter'),70)};
    }
    mb.addEventListener('click',e=>{
      const target=e.target.closest('.order-row button,.bev-order,.approval-btn');
      if(target) {sparkFrom(target); target.classList.add('menu-toast-pulse'); setTimeout(()=>target.classList.remove('menu-toast-pulse'),700)}
      const food=e.target.closest('.food,.individual-item,.beverage-card');
      if(food && !e.target.closest('button')) {food.animate([{transform:'translateX(0)'},{transform:'translateX(4px)'},{transform:'translateX(0)'}],{duration:340,easing:'ease-out'});}
    });
    const observer=new MutationObserver(()=>{ if(mb.style.display==='block'){mb.classList.add('menu-active');setTimeout(()=>animateMenu('render'),30);} });
    const ml=document.getElementById('menuList'); if(ml) observer.observe(ml,{childList:true});
  }
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',bindMenu); else bindMenu();
})();
</script>

