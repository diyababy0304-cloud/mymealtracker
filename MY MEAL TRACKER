      {id:2005,patient:'Kavitha',room:'522',meal:'Cardiac Low-Sodium Bowl',diet:'Cardiac Low-Sodium',chef:null,events:[{stage:'placed',time:t(3)}]},
      {id:2006,patient:'Ramesh',room:'260',meal:'Renal-Friendly Khichdi',diet:'Renal-Friendly',dietitianBy:'Dr. Meera Iyer — Renal Diet',chef:null,events:[
        {stage:'placed',time:t(15)},{stage:'dietitian_approved',time:t(12)}]},
      {id:2007,patient:'Priyanka',room:'333',meal:'High Protein Paneer Bowl',diet:'High Protein',dietitianBy:'Dr. Johnson — Diabetic Care',fnbBy:'Vikram — Tray Verification',chef:null,events:[
        {stage:'placed',time:t(18)},{stage:'dietitian_approved',time:t(15)},{stage:'fnb_received',time:t(14)}]},
